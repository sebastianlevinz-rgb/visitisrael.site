---
/**
 * /photo-credits — every photo the site uses, with photographer, source and
 * licence. English-only, like the other legal pages. Generated from the ledger
 * (data/photo-credits.json), so it can never drift from what is actually served.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Pic from '@/components/Pic.astro';
import { allCredits, SOURCE_NAMES } from '@/lib/photos';

const credits = allCredits();
const title = 'Photo Credits';
const description =
  'Every photograph on Visit Israel, with the photographer, where it came from and the licence it is used under. No AI-generated images.';
const path = '/photo-credits';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: title, path },
];
const bySource = credits.reduce<Record<string, number>>((acc, c) => {
  acc[c.source] = (acc[c.source] ?? 0) + 1;
  return acc;
}, {});
const sourceSummary = Object.entries(bySource)
  .map(([s, n]) => `${n} from ${SOURCE_NAMES[s as keyof typeof SOURCE_NAMES] ?? s}`)
  .join(', ');
const updated = credits.map((c) => c.downloadedAt).sort().at(-1)?.slice(0, 10);
const pageLabel = (slug: string) => (slug === 'home' ? '/' : slug === 'og-default' ? 'social preview card' : `/${slug}`);
---

<BaseLayout title={title} description={description} path={path} ogImage="/og-default.jpg" imageAlt={title}>
  <header class="bg-sand-deep">
    <div class="mx-auto max-w-3xl px-4 py-12">
      <h1 class="font-display text-4xl font-bold text-ink">{title}</h1>
      <p class="mt-3 text-lg text-ink-muted">
        {credits.length} photographs — {sourceSummary}. Every image on this site is a photograph of the place it
        illustrates, taken by the person credited below. We do not use AI-generated imagery.
      </p>
      {updated && <p class="mt-2 text-sm text-ink-muted">Ledger last updated {updated}.</p>}
    </div>
  </header>
  <Breadcrumbs items={crumbs} />

  <article class="prose-content mx-auto max-w-3xl px-4 pt-6">
    <p>
      Photos from <a href="https://www.pexels.com/" rel="noopener">Pexels</a> are used under the
      <a href="https://www.pexels.com/license/" rel="noopener">Pexels License</a>. Photos from
      <a href="https://commons.wikimedia.org/" rel="noopener">Wikimedia Commons</a> are used under the Creative
      Commons licence stated for each file; where the licence is CC BY-SA, our resized copy of that photo is
      available under the same licence. Every photo has been resized (and may have been cropped) for the web.
      If you are a photographer and something here is wrong, <a href="/contact">contact us</a>.
    </p>
  </article>

  <section class="mx-auto max-w-6xl px-4 pt-8" aria-label="Photo credits list">
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        credits.map((c) => (
          <li class="overflow-hidden rounded-card border border-border bg-card shadow-card">
            <div class="aspect-[3/2] overflow-hidden">
              <Pic
                src={c.path}
                alt={c.alt}
                width="800"
                height="533"
                loading="lazy"
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="p-4 text-sm">
              <p class="font-semibold text-ink">{c.alt}</p>
              <p class="mt-2 text-ink-muted">
                Photo:{' '}
                <a href={c.authorUrl} rel="noopener" target="_blank" class="font-semibold text-primary">
                  {c.author}
                </a>
                {' · '}
                <a href={c.sourceUrl} rel="noopener" target="_blank" class="text-primary">
                  {SOURCE_NAMES[c.source] ?? c.source}
                </a>
                {' · '}
                <a href={c.licenseUrl} rel="noopener" target="_blank" class="text-primary">
                  {c.license}
                </a>
              </p>
              <p class="mt-1 text-xs text-ink-muted">
                Original {c.origWidth}×{c.origHeight}, resized to {c.width}×{c.height}.
              </p>
              {c.usedBy.length > 0 && (
                <p class="mt-1 text-xs text-ink-muted">Used on: {c.usedBy.map(pageLabel).join(', ')}</p>
              )}
              <p class="mt-1 font-mono text-[11px] text-ink-muted">{c.path}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
