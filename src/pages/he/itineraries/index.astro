---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const allItineraries = await getCollection('itineraries');
const itineraries = allItineraries
  .filter((e) => e.id.startsWith('he/'))
  .sort((a, b) => (a.data.days ?? 0) - (b.data.days ?? 0));
const title = 'מסלולי טיול בישראל: מסלולים של 7 ו-10 ימים';
const description =
  'מסלולי טיול מוכנים בישראל — טיול ראשון קלאסי של 7 ימים ומסלול של 10 ימים שמוסיף את הצפון ואת המדבר, עם סיורים, מלונות ותחבורה.';
const crumbs = [
  { name: 'דף הבית', path: '/he/' },
  { name: 'מסלולי טיול', path: '/he/itineraries' },
];
---

<BaseLayout title={title} description={description} path="/he/itineraries">
  <Hero
    image="/images/regions/jerusalem/hero.jpg"
    title="מסלולי טיול בישראל"
    subtitle="מסלולים יום אחר יום למבקרים בפעם הראשונה ולמי שחוזרים."
    alt="העיר העתיקה בירושלים — נקודת הפתיחה של מסלולי טיול רבים בישראל"
  />
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-6xl px-4 pt-10">
    <p class="mx-auto max-w-3xl text-lg leading-relaxed text-ink">
      לא בטוחים איך לחבר את ישראל לטיול אחד? המסלולים האלה עושים את העבודה בשבילכם —
      כל אחד מאזן בין האתרים שאסור לפספס לבין זמני נסיעה ריאליים, ומקשר ישירות לסיורים,
      למלונות ולתחבורה שתצטרכו.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        itineraries.map((it) => {
          const baseId = it.id.slice(3); // strip 'he/'
          return (
            <a
              href={`/he/itineraries/${baseId}`}
              class="group relative block aspect-[3/2] overflow-hidden rounded-card shadow-card transition-shadow hover:shadow-card-hover"
            >
              <img
                src={it.data.heroImage ?? '/images/regions/jerusalem/hero.jpg'}
                alt={it.data.title}
                width="800"
                height="533"
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="photo-overlay absolute inset-0" />
              <div class="absolute inset-x-0 bottom-0 p-5">
                {it.data.days && (
                  <span class="photo-title text-xs font-semibold uppercase tracking-widest opacity-90">
                    {it.data.days} ימים
                  </span>
                )}
                <h2 class="photo-title mt-1 font-display text-xl font-bold leading-tight">
                  {it.data.title}
                </h2>
              </div>
            </a>
          );
        })
      }
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-ink-muted">
      מסלולים נוספים מתווספים באופן קבוע. בינתיים, עברו על
      <a href="/he/" class="font-semibold text-primary">7 האזורים</a> או התחילו
      <a href="/he/first-time-in-israel" class="font-semibold text-primary">במדריך לפעם הראשונה בישראל</a>.
    </p>
  </section>
</BaseLayout>
