---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import AffiliateCard from '@/components/AffiliateCard.astro';
import FaqSection from '@/components/FaqSection.astro';
import JsonLd from '@/components/JsonLd.astro';
import { defaultAuthor } from '@/data/authors';
import { article, breadcrumbList, faqPage, touristTrip } from '@/lib/schema';
import { locales, entryIdFor, splitEntryId, alternatesFor } from '@/i18n/ui';

export async function getStaticPaths() {
  const allItineraries = await getCollection('itineraries');
  const heItineraries = allItineraries.filter((e) => splitEntryId(e.id).locale === 'he');
  const idSet = new Set(allItineraries.map((e) => e.id));
  return heItineraries.map((entry) => {
    const baseId = splitEntryId(entry.id).slug;
    // hreflang from the itinerary entries that actually exist, in every locale.
    const alternates = alternatesFor(
      `itineraries/${baseId}`,
      locales.filter((l) => idSet.has(entryIdFor(l, baseId)))
    );
    return { params: { slug: baseId }, props: { entry, baseId, alternates } };
  });
}

const { entry, baseId, alternates = [] } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const hero = d.heroImage ?? '/images/regions/jerusalem/hero.jpg';
const path = `/he/itineraries/${baseId}`;

const crumbs = [
  { name: 'דף הבית', path: '/he/' },
  { name: 'מסלולי טיול', path: '/he/itineraries' },
  { name: d.title, path },
];

// Card copy is Hebrew; partner search queries stay in English (they are what the
// partner site searches for).
const isTelAviv = d.startRegion === 'tel-aviv';
const tours = isTelAviv
  ? [
      { partner: 'getyourguide' as const, title: 'סיור אוכל ושווקים בתל אביב', description: 'טועמים את שוק הכרמל ויפו העתיקה עם מדריך מקומי שחי אוכל.', image: '/images/regions/tel-aviv/carmel-market.jpg', query: 'Tel Aviv food tour' },
      { partner: 'viator' as const, title: 'סיור רגלי ביפו', description: 'עיר הנמל העתיקה, שוק הפשפשים והתצפית מראש הגבעה עם מדריך.', image: '/images/regions/tel-aviv/jaffa.jpg', query: 'Old Jaffa walking tour' },
      { partner: 'civitatis' as const, title: 'טיול יום למצדה ולים המלח מתל אביב', description: 'זריחה במצדה וציפה בים המלח — טיול יום מתל אביב.', image: '/images/regions/dead-sea/hero.jpg', query: 'Masada Dead Sea day trip Tel Aviv' },
    ]
  : [
      { partner: 'getyourguide' as const, title: 'סיור בעיר העתיקה בירושלים', description: 'ארבעת הרבעים והאתרים הקדושים עם מדריך מקומי.', image: '/images/regions/jerusalem/hero.jpg', query: 'Jerusalem Old City tour' },
      { partner: 'viator' as const, title: 'טיול יום למצדה ולים המלח', description: 'זריחה במצדה וציפה בים המלח.', image: '/images/regions/dead-sea/hero.jpg', query: 'Masada Dead Sea day trip' },
      { partner: 'civitatis' as const, title: 'סיור אוכל בתל אביב וביפו', description: 'שוק הכרמל ויפו העתיקה עם מדריך שמכיר כל דוכן.', image: '/images/regions/tel-aviv/hero.jpg', query: 'Tel Aviv Jaffa food tour' },
    ];

const schema = [
  article({ headline: d.title, description: d.description, image: hero, path, authorName: defaultAuthor.name, authorUrl: defaultAuthor.url, datePublished: d.publishedAt, dateModified: d.updatedAt }),
  breadcrumbList(crumbs),
  touristTrip({ name: d.title, description: d.description, image: hero, path, days: d.days }),
  ...(d.faqs && d.faqs.length > 0 ? [faqPage(d.faqs)] : []),
];
---

<BaseLayout title={d.title} description={d.description} path={path} image={hero} alternates={alternates}>
  <JsonLd slot="head" schema={schema} />
  <Hero image={hero} title={d.title} subtitle={d.days ? `מסלול של ${d.days} ימים` : undefined} alt={d.title} />
  <Breadcrumbs items={crumbs} />
  <AuthorByline updated={d.updatedAt} />

  <article class="prose-content mx-auto max-w-3xl px-4 pt-4">
    <Content />
  </article>

  <section class="mx-auto max-w-6xl px-4 pt-10" aria-labelledby="book">
    <h2 id="book" class="mb-5 font-display text-3xl font-bold text-ink">הזמינו את החוויות המרכזיות</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {tours.map((t) => <AffiliateCard {...t} />)}
    </div>
  </section>

  <FaqSection faqs={d.faqs ?? []} />
  <AuthorByline updated={d.updatedAt} />
</BaseLayout>
