---
/**
 * /gestion — mapa de todas las páginas internas y de utilidad que no salen en la
 * navegación pública, más los documentos de gestión del repo en GitHub.
 *
 * noindex (InternalLayout), fuera del sitemap y del chequeo de huérfanas
 * (scripts/qa/check-links.mjs excluye /gestion y todo lo que cuelgue).
 * Si se agrega una página noindex, se suma acá a mano: este mapa no se autogenera.
 */
import InternalLayout from '@/layouts/InternalLayout.astro';

const REPO = 'https://github.com/sebastianlevinz-rgb/visitisrael.site/blob/master';
const gh = (path: string) => `${REPO}/${path}`;

type Page = { href: string; label: string; desc: string; noindex: boolean };
type Group = { title: string; note?: string; pages: Page[] };

const groups: Group[] = [
  {
    title: 'Gestión (noindex)',
    note: 'Solo para el equipo. Usan InternalLayout: sin navegación pública, sin sitemap.',
    pages: [
      { href: '/dashboard', label: '/dashboard', desc: 'Panel de control: foto del sitio al momento del build (páginas, idiomas, afiliados, redirects, pendientes del ROADMAP).', noindex: true },
      { href: '/gestion', label: '/gestion', desc: 'Este mapa: índice de páginas internas y documentos de gestión.', noindex: true },
      { href: '/gestion/competidores', label: '/gestion/competidores', desc: 'Estudio de mercado: competidores de visitisrael.site y qué hacen mejor o peor.', noindex: true },
      { href: '/gestion/seo', label: '/gestion/seo', desc: 'Auditoría SEO continua: on-page del build, PageSpeed, keywords, competidores y backlinks (data/seo/*.json, se refresca con pnpm seo:refresh).', noindex: true },
      { href: '/mariluz', label: '/mariluz', desc: 'Propuesta de sociedad para Mariluz (guía licenciada), publicada desde gestion/negocio/propuesta-mariluz.md para mandarle el link.', noindex: true },
      { href: '/gestion/video', label: '/gestion/video', desc: 'Playbook de video (23-09-2026): qué funciona en YouTube y TikTok sobre Israel, formato long-form → shorts, 30 ideas, top 10 por jornada, plan de rodaje. Página estática en public/gestion/video (misma que el artefacto de claude.ai).', noindex: true },
      { href: '/mariluz/paquetes', label: '/mariluz/paquetes', desc: 'Borrador para Mariluz: qué venden los 6 catálogos (frecuencia y precios de grupo publicados), 10 paquetes ejemplares con recorrido y bloque para que complete, y preguntas. Datos en src/data/mariluz-paquetes.ts.', noindex: true },
    ],
  },
  {
    title: 'Utilidad (públicas, fuera del menú)',
    note: 'Se llega desde el footer o desde el buscador, no desde la navegación principal.',
    pages: [
      { href: '/search', label: '/search', desc: 'Buscador del sitio (Pagefind). noindex.', noindex: true },
      { href: '/photo-credits', label: '/photo-credits', desc: 'Créditos de todas las fotos: autor, fuente y licencia, generados del ledger data/photo-credits.json. Enlazada en el footer.', noindex: false },
      { href: '/404', label: '/404', desc: 'Página de error. noindex; no cuenta como ruta del build.', noindex: true },
      { href: '/rss.xml', label: '/rss.xml', desc: 'Feed RSS de las guías.', noindex: false },
      { href: '/sitemap-index.xml', label: '/sitemap-index.xml', desc: 'Sitemap generado por @astrojs/sitemap; excluye todo lo noindex.', noindex: false },
    ],
  },
];

type Pending = {
  status: 'pendiente' | 'decidido' | 'futuro';
  title: string;
  date: string;
  text: string;
  link?: { href: string; label: string };
};
const pending: Pending[] = [
  {
    status: 'futuro',
    title: 'Dominio visitisrael.com (US$200)',
    date: '22-09-2026',
    text: 'Decidido seguir con .site. Google no da ventaja de ranking por la terminación: el .com suma confianza, memoria y tráfico directo, no posiciones. Retomar cuando haya ingresos o cuando aparezca a menor precio. Si se compra: redirect 301 de todo el .site al .com, cambio de propiedad en Search Console y actualización de todos los links de afiliado.',
  },
  {
    status: 'pendiente',
    title: 'Search Console + disavow',
    date: '22-09-2026',
    text: 'Verificar visitisrael.site, enviar sitemap-index.xml y subir gestion/seo/disavow.txt (16 backlinks tóxicos). Sin esto no hay datos reales de impresiones ni reindexación rápida del sitio nuevo. Opcional: Bing Webmaster + IndexNow.',
    link: { href: '/gestion/seo', label: 'Ver auditoría SEO' },
  },
  {
    status: 'pendiente',
    title: 'IDs de afiliados',
    date: '22-09-2026',
    text: 'Aplicar a GetYourGuide, Viator, Civitatis, Bein Harim (15 %, 90 días), Booking vía CJ o Awin, y Travelpayouts (Skyscanner, Airalo, Holafly, DiscoverCars). Con los IDs cargados en Vercel y PUBLIC_AFFILIATE_MODE=production, el build exige que ninguno falte. Hoy: 20 partners configurados, 0 con ID.',
    link: { href: '/dashboard', label: 'Ver partners en el panel' },
  },
  {
    status: 'pendiente',
    title: 'Autor con nombre y cara',
    date: '22-09-2026',
    text: 'Si Mariluz dice que sí: nombre, licencia, foto y bio en 5 idiomas en /about y firma en cada guía. Es la acción 2 del estudio de competidores y de la auditoría SEO.',
    link: { href: '/mariluz', label: 'Propuesta' },
  },
  {
    status: 'pendiente',
    title: 'WhatsApp y formulario del sitio',
    date: '22-09-2026',
    text: 'Acordado con Mariluz: cada cliente que llega por el sitio queda registrado. Falta el número de WhatsApp del sitio para armar el formulario y el mensaje automático.',
  },
  {
    status: 'pendiente',
    title: 'Guía de eSIM para Israel',
    date: '22-09-2026',
    text: 'Propuesta: una guía "eSIM para Israel: cuál conviene y planes" en 5 idiomas, con Airalo (EN/FR/DE), Holafly (ES) y comparación honesta (datos, precio orientativo, cobertura). Partners ya configurados. Es una página nueva: requiere el OK explícito de Sebastian.',
  },
  {
    status: 'pendiente',
    title: 'Keys y accesos',
    date: '22-09-2026',
    text: 'Unsplash (401) y Exa (inválida) no funcionan; no bloquean nada. Opcionales: PSI_API_KEY para PageSpeed sin cuota, y activar Vercel Analytics para medir clics por caja.',
  },
];

type Doc = { path: string; desc: string };
type DocGroup = { title: string; docs: Doc[] };

const docGroups: DocGroup[] = [
  {
    title: 'Raíz del repo',
    docs: [
      { path: 'CLAUDE.md', desc: 'Reglas de trabajo, stack real y trampas conocidas. Se lee antes de tocar cualquier cosa.' },
      { path: 'ROADMAP.md', desc: 'Fase actual y pendientes; el dashboard lee los checkboxes de acá.' },
      { path: 'REVIEW.md', desc: 'Estándar de calidad de página: qué tiene que tener una página para estar bien.' },
      { path: 'README.md', desc: 'Presentación técnica del proyecto.' },
      { path: 'SECURITY.md', desc: 'Política de seguridad y reporte de vulnerabilidades.' },
    ],
  },
  {
    title: 'gestion/auditoria',
    docs: [
      { path: 'gestion/auditoria/estado-del-sitio.md', desc: 'Auditoría general: estado del sitio con números.' },
      { path: 'gestion/auditoria/cobertura-afiliados.md', desc: 'Qué páginas tienen CTAs de afiliado y cuáles no.' },
      { path: 'gestion/auditoria/competidores.md', desc: 'Estudio de mercado: fuente de /gestion/competidores.' },
      { path: 'gestion/auditoria/seo.md', desc: 'Auditoría SEO: diagnóstico y plan de acción; fuente de la sección Diagnóstico de /gestion/seo.' },
      { path: 'gestion/auditoria/diseno-referentes.md', desc: 'Referentes de diseño y qué se tomó de cada uno.' },
      { path: 'gestion/auditoria/diseno-2026-09-17.md', desc: 'Auditoría de diseño de la home (móvil y escritorio) del 17-sep-2026.' },
      { path: 'gestion/auditoria/fotos.md', desc: 'Pipeline de fotos: manifest, ledger de créditos y guardia de build.' },
      { path: 'gestion/auditoria/loop-detenido.md', desc: 'Por qué se cortó el loop autónomo y qué no hay que volver a hacer.' },
    ],
  },
  {
    title: 'gestion/negocio',
    docs: [
      { path: 'gestion/negocio/propuesta-mariluz.md', desc: 'Fuente de /mariluz: la propuesta para ella, conceptual y sin números (Mari curadora, Sebastian brazo tecnológico).' },
      { path: 'src/components/MariluzModelo.astro', desc: 'Segunda parte de /mariluz: embudo del visitante, fuentes de ingreso, cuánto paga cada afiliado, regla de reparto, mes de ejemplo, roles y lo acordado.' },
      { path: 'gestion/negocio/propuesta-mariluz-numeros.md', desc: 'Anexo interno de Sebastian: guion de video, flujo de fondos a 12 meses, reparto, cláusulas. No se le manda.' },
      { path: 'gestion/negocio/contenido-video.md', desc: 'Research de video (23-09-2026): datos de YouTube, formato long-form → shorts, 30 ideas, top 10 por jornada, plan de rodaje. Artefacto: claude.ai/artifact/RdySjCjW5kiyzgGJZVAjxx.' },
      { path: 'gestion/negocio/benchmarks.md', desc: 'Datos de respaldo de la propuesta: comisiones de plataformas, turismo, tarifas.' },
    ],
  },
  {
    title: 'gestion/rutinas',
    docs: [
      { path: 'gestion/rutinas/auditar-pagina.md', desc: 'Prompt recurrente para auditar una página contra REVIEW.md.' },
      { path: 'gestion/rutinas/inventario-del-sitio.md', desc: 'Prompt recurrente para levantar el inventario de páginas.' },
      { path: 'gestion/rutinas/tanda-de-consolidacion.md', desc: 'Prompt recurrente para una tanda de consolidación de contenido.' },
      { path: 'gestion/rutinas/verificar-loop-muerto.md', desc: 'Prompt recurrente para comprobar que el loop sigue apagado.' },
    ],
  },
  {
    title: 'gestion/rebuild',
    docs: [
      { path: 'gestion/rebuild/mapa-redirects.csv', desc: 'Mapa completo de las 1.919 URLs viejas y su destino 301.' },
      { path: 'gestion/rebuild/redirects.mjs', desc: 'Genera los redirects de vercel.json a partir del mapa; correr después de un build.' },
    ],
  },
];
---

<InternalLayout title="Mapa interno">
  <h1 class="font-display text-3xl font-bold">Mapa interno</h1>
  <p class="mt-2 max-w-3xl text-ink-muted">
    Índice de las páginas que no salen en la navegación pública y de los documentos de gestión del repo.
  </p>
  <div class="mt-4 max-w-3xl rounded-card border border-gold bg-gold/10 px-4 py-3 text-sm">
    <strong>Páginas noindex:</strong> no aparecen en Google ni en el sitemap, pero cualquiera con el link las puede ver.
    No poner acá nada que no pueda circular.
  </div>

  {
    groups.map((g) => (
      <section class="mt-10">
        <h2 class="font-display text-2xl font-bold">{g.title}</h2>
        {g.note && <p class="mt-1 text-sm text-ink-muted">{g.note}</p>}
        <ul class="mt-4 grid gap-3 md:grid-cols-2">
          {g.pages.map((p) => (
            <li class="rounded-card border border-border bg-card p-4 shadow-card">
              <a href={p.href} class="font-mono text-sm font-semibold text-primary no-underline hover:underline">
                {p.label}
              </a>
              {p.noindex && (
                <span class="ms-2 rounded-full bg-sand-deep px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-ink-muted">
                  noindex
                </span>
              )}
              <p class="mt-1 text-sm">{p.desc}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="mt-12" id="pendientes">
    <h2 class="font-display text-2xl font-bold">Decisiones y pendientes</h2>
    <p class="mt-1 text-sm text-ink-muted">
      Lo que solo Sebastian puede hacer o decidir, con fecha. Se actualiza a mano; el detalle técnico vive en
      <code>ROADMAP.md</code>.
    </p>
    <ul class="mt-4 space-y-3">
      {
        pending.map((p) => (
          <li class="rounded-card border border-border bg-card p-4 shadow-card">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span
                class={`rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${
                  p.status === 'decidido' ? 'bg-primary-soft text-primary' : p.status === 'futuro' ? 'bg-sand-deep text-ink-muted' : 'bg-gold/15 text-gold-deep'
                }`}
              >
                {p.status}
              </span>
              <p class="font-display text-lg font-bold">{p.title}</p>
              <span class="text-xs text-ink-muted">{p.date}</span>
            </div>
            <p class="mt-1 text-sm">{p.text}</p>
            {p.link && (
              <a href={p.link.href} class="mt-1 inline-block text-sm text-primary underline">
                {p.link.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12">
    <h2 class="font-display text-2xl font-bold">Documentos de gestión (GitHub)</h2>
    <p class="mt-1 text-sm text-ink-muted">
      Abren en el repo, rama <code>master</code>. Editar ahí; el sitio no los copia salvo <code>/mariluz</code>, que se genera del markdown en cada build.
    </p>
    {
      docGroups.map((dg) => (
        <div class="mt-6">
          <h3 class="font-display text-lg font-bold">{dg.title}</h3>
          <ul class="mt-2 divide-y divide-border rounded-card border border-border bg-card shadow-card">
            {dg.docs.map((d) => (
              <li class="flex flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:gap-4">
                <a href={gh(d.path)} class="shrink-0 font-mono text-sm font-semibold text-primary no-underline hover:underline">
                  {d.path} ↗
                </a>
                <span class="text-sm text-ink-muted">{d.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</InternalLayout>
