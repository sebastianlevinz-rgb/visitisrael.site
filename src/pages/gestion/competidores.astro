---
/**
 * /gestion/competidores — el estudio de mercado de competidores, contado en tarjetas
 * (CompetidoresPanel.astro, mismo lenguaje visual que /mariluz#numeros) y, al final,
 * el markdown completo gestion/auditoria/competidores.md dentro de un <details>.
 *
 * Los datos del panel salen del markdown; el markdown sigue siendo la fuente.
 *
 * noindex (InternalLayout), fuera del sitemap y del chequeo de huérfanas.
 * La H1 la pone el panel; al markdown se le quita su H1 para que haya una sola
 * (el smoke test exige una sola H1).
 */
import InternalLayout from '@/layouts/InternalLayout.astro';
import CompetidoresPanel from '@/components/CompetidoresPanel.astro';
import { compiledContent } from '../../../gestion/auditoria/competidores.md';

const source =
  'https://github.com/sebastianlevinz-rgb/visitisrael.site/blob/master/gestion/auditoria/competidores.md';

// El markdown abre con "# Competidores — estudio de mercado": se baja a <p> para no duplicar la H1.
const reportHtml = (await compiledContent()).replace(
  /^\s*<h1[^>]*>([\s\S]*?)<\/h1>/,
  '<p class="font-display text-xl font-bold">$1</p>',
);
---

<InternalLayout title="Competidores" documentTitle="Competidores — VisitIsrael">
  <CompetidoresPanel>
    <Fragment set:html={reportHtml} />
  </CompetidoresPanel>
  <footer class="mx-auto mt-12 max-w-5xl border-t border-border pt-4 text-xs text-ink-muted">
    <p>
      Página interna de visitisrael.site: no aparece en Google ni en el sitemap; cualquiera con el link la puede ver.
      Fuente: <a href={source} class="text-primary underline">competidores.md</a> en GitHub.
    </p>
  </footer>
</InternalLayout>
