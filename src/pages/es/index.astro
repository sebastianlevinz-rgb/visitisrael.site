---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import DestinationCard from '@/components/DestinationCard.astro';
import { REGIONS } from '@/data/regions';
import { useTranslations, homeAlternates } from '@/i18n/ui';

const t = useTranslations('es');
const esEntries = await getCollection('regions');
const esSlugs = new Set(esEntries.filter((e) => e.id.startsWith('es/')).map((e) => e.id.slice(3)));
const title = 'Visitar Israel — Guía de viaje';
const description =
  'Planifica tu viaje a Israel: 11 regiones desde Jerusalén hasta el Mar Rojo, itinerarios, qué ver y enlaces de reserva de confianza. Guías detalladas en inglés.';
---

<BaseLayout
  title={title}
  description={description}
  path="/es/"
  ogImage="/og-default.jpg"
  imageAlt="Visitar Israel — guía de viaje"
  alternates={homeAlternates()}
>
  <Hero
    image="/images/regions/jerusalem/hero.jpg"
    title={t('home.heroTitle')}
    subtitle={t('home.heroSubtitle')}
    alt="Vista aérea de la Ciudad Antigua de Jerusalén a la hora dorada"
  />

  <section class="mx-auto max-w-3xl px-4 pt-10">
    <p class="rounded-card border border-border bg-sand-deep p-5 text-ink-muted">
      {t('home.rolloutNotice')}
      <a href="/" class="mt-2 inline-block font-semibold text-primary">{t('home.englishCta')} →</a>
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="regions-es">
    <h2 id="regions-es" class="mb-5 font-display text-3xl font-bold text-ink">
      {t('home.regionsHeading')}
    </h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {REGIONS.map((r, i) => (
        <DestinationCard
          region={r}
          eager={i < 4}
          href={esSlugs.has(r.slug) ? `/es/${r.slug}` : undefined}
        />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14 text-center">
    <a
      href="/es/plan-your-trip"
      class="inline-block rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
    >
      {t('home.planHeading')}
    </a>
  </section>
</BaseLayout>
