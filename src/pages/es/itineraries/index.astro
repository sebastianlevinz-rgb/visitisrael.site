---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

const allItineraries = await getCollection('itineraries');
const itineraries = allItineraries
  .filter((e) => e.id.startsWith('es/'))
  .sort((a, b) => (a.data.days ?? 0) - (b.data.days ?? 0));

const title = 'Itinerarios por Israel: rutas de 3, 5, 7 y 10 días';
const description =
  'Itinerarios listos para Israel adaptados a cada duración de viaje — de 3 días en Jerusalén a una semana clásica o más, con tours, hoteles y transporte.';
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Itinerarios', path: '/es/itineraries' },
];
---

<BaseLayout title={title} description={description} path="/es/itineraries">
  <Hero
    image="/images/regions/jerusalem/hero.jpg"
    title="Itinerarios por Israel"
    subtitle="Rutas día a día para primeros visitantes y viajeros con experiencia."
    alt="Ciudad Antigua de Jerusalén — punto de partida de muchos itinerarios por Israel"
  />
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-6xl px-4 pt-10">
    <p class="mx-auto max-w-3xl text-lg leading-relaxed text-ink">
      ¿No sabes cómo organizar tu viaje a Israel? Estos itinerarios hacen la planificación por ti
      — cada uno equilibra los imprescindibles con tiempos de traslado realistas, y enlaza
      directamente a los tours, hoteles y transporte que necesitas.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        itineraries.map((it) => {
          const baseId = it.id.slice(3); // strip 'es/'
          return (
            <a
              href={`/es/itineraries/${baseId}`}
              class="group relative block aspect-[3/2] overflow-hidden rounded-card shadow-card transition-shadow hover:shadow-card-hover"
            >
              <img
                src={it.data.heroImage ?? '/images/regions/jerusalem/hero.jpg'}
                alt={it.data.title}
                width="800"
                height="533"
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="photo-overlay absolute inset-0" />
              <div class="absolute inset-x-0 bottom-0 p-5">
                {it.data.days && (
                  <span class="photo-title text-xs font-semibold uppercase tracking-widest opacity-90">
                    {it.data.days} días
                  </span>
                )}
                <h2 class="photo-title mt-1 font-display text-xl font-bold leading-tight">
                  {it.data.title}
                </h2>
              </div>
            </a>
          );
        })
      }
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-ink-muted">
      Se añaden nuevas rutas regularmente. Mientras tanto, explora las
      <a href="/es/" class="font-semibold text-primary">11 regiones</a> o empieza con nuestra
      <a href="/" class="font-semibold text-primary">guía completa en inglés</a>.
    </p>
  </section>
</BaseLayout>
