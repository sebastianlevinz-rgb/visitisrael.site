---
/**
 * /mariluz/paquetes — borrador de paquetes para que Mariluz revise: qué venden los seis
 * catálogos (tabla de frecuencia), 10 paquetes ejemplares con recorrido, referencia de mercado
 * y un bloque de formulario para que ella complete, y las preguntas abiertas.
 * Datos en src/data/mariluz-paquetes.ts. Copia del lenguaje visual de MariluzModelo.astro.
 *
 * noindex (InternalLayout), fuera del sitemap y del chequeo de huérfanas (prefijo /mariluz).
 * Una sola H1 (el smoke test la exige).
 */
import InternalLayout from '@/layouts/InternalLayout.astro';
import { CATALOGOS, FRECUENCIA, PAQUETES, CAMPOS_MARI, PREGUNTAS_MARI, FECHA_RELEVAMIENTO } from '@/data/mariluz-paquetes';

const total = CATALOGOS.length;
const nombre = (sigla: string) => CATALOGOS.find((c) => c.sigla === sigla)?.nombre ?? sigla;
const tipoLabel = { clasico: 'Clásico del mercado', diferencial: 'Diferencial de Mari' } as const;
---

<InternalLayout title="Paquetes para revisar" documentTitle="Paquetes para revisar — Mariluz · VisitIsrael" bare>
  <article class="mx-auto max-w-5xl">
    <p class="eyebrow">Borrador · {FECHA_RELEVAMIENTO}</p>
    <h1 class="font-display text-3xl font-bold leading-tight text-ink sm:text-4xl">Paquetes para revisar</h1>
    <div class="mt-4 max-w-3xl space-y-2 text-lg text-ink-muted">
      <p>
        Mari: esto es un borrador armado mirando qué venden Tourist Israel, Bein Harim, Abraham, Civitatis,
        GetYourGuide y Viator. Elegimos lo que más se repite y sumamos tres cosas que ellos no tienen y vos sí.
      </p>
      <p>
        Corregí, tachá, agregá. Los precios que aparecen son los que publican ellos para tours de grupo (en
        bus, en inglés); sirven de referencia, no son tuyos. <strong class="text-ink">Tu precio lo ponés vos</strong> en
        el recuadro dorado de cada paquete. Nada de esto es público todavía.
      </p>
      <p class="text-base">
        Al final hay ocho preguntas. Podés contestar por WhatsApp o marcar acá arriba de una impresión.
        <a href="/mariluz" class="text-primary">Volver a la propuesta</a>.
      </p>
    </div>

    <!-- Frecuencia -->
    <section class="mt-12">
      <p class="eyebrow">Primero</p>
      <h2 class="font-display text-2xl font-bold text-ink">Qué venden todos</h2>
      <p class="mt-2 max-w-3xl text-ink-muted">
        Cada tour, en cuántos de los {total} catálogos aparece y con qué precio de grupo publicado. Leído el
        {FECHA_RELEVAMIENTO}; Viator publica en shékels (₪) y Abraham también.
      </p>
      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        {
          CATALOGOS.map((c) => (
            <span class="rounded-full border border-border bg-card px-3 py-1 text-ink-muted" title={c.como}>
              <strong class="text-ink">{c.sigla}</strong> {c.nombre} · {c.moneda}
            </span>
          ))
        }
      </div>
      <ol class="mt-6 space-y-3">
        {
          FRECUENCIA.map((f) => {
            const n = f.en.length;
            const extra = f.segunAuditoria?.length ?? 0;
            return (
              <li class="rounded-card border border-border bg-card p-4 shadow-card">
                <div class="flex items-start justify-between gap-3">
                  <p class="font-display text-lg font-bold leading-tight text-ink">{f.tour}</p>
                  <p class="shrink-0 rounded-full bg-primary-soft px-3 py-1 font-display text-sm font-bold text-primary">
                    {n}{extra ? `+${extra}` : ''}/{total}
                  </p>
                </div>
                <p class="mt-1 text-sm text-ink">
                  {f.en.map(nombre).join(', ')}
                  {extra ? <span class="text-ink-muted"> (+ {f.segunAuditoria!.map(nombre).join(', ')} según el relevamiento del 16-09, no en la primera página de hoy)</span> : null}
                </p>
                <dl class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-[auto_1fr]">
                  <dt class="font-semibold text-ink-muted">Duración</dt>
                  <dd class="text-ink">{f.duracion}</dd>
                  <dt class="font-semibold text-ink-muted">Salida</dt>
                  <dd class="text-ink">{f.salida}</dd>
                  <dt class="font-semibold text-ink-muted">Precio grupal</dt>
                  <dd class="text-ink">{f.rango}</dd>
                </dl>
                {f.nota && <p class="mt-2 text-sm text-ink-muted">{f.nota}</p>}
              </li>
            );
          })
        }
      </ol>
    </section>

    <!-- Paquetes -->
    <section class="mt-16">
      <p class="eyebrow">Segundo</p>
      <h2 class="font-display text-2xl font-bold text-ink">{PAQUETES.length} paquetes para empezar</h2>
      <p class="mt-2 max-w-3xl text-ink-muted">
        Siete que todos venden y tres que aprovechan que sos guía privada y trilingüe. Los tiempos de cada
        parada son aproximados: vos sabés cuánto lleva de verdad.
      </p>

      <div class="mt-8 space-y-10">
        {
          PAQUETES.map((p, i) => {
            const gold = p.tipo === 'diferencial';
            return (
              <article id={p.id} class={`overflow-hidden rounded-card border-2 bg-card shadow-card ${gold ? 'border-gold' : 'border-primary/40'}`}>
                <header class={`px-5 py-5 sm:px-6 ${gold ? 'bg-gold-deep text-white' : 'bg-primary text-white'}`}>
                  <p class="text-xs font-semibold uppercase tracking-widest opacity-80">
                    Paquete {i + 1} · {tipoLabel[p.tipo]}
                  </p>
                  <h3 class="mt-1 font-display text-2xl font-bold leading-tight">{p.nombre}</h3>
                  <p class="mt-2 text-sm opacity-90">{p.porQue}</p>
                </header>

                <div class="space-y-6 px-5 py-5 sm:px-6">
                  <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
                    <dt class="font-semibold text-ink-muted">Duración</dt>
                    <dd class="text-ink">{p.duracion}</dd>
                    <dt class="font-semibold text-ink-muted">Salida</dt>
                    <dd class="text-ink">{p.salida}</dd>
                    <dt class="font-semibold text-ink-muted">Para quién</dt>
                    <dd class="text-ink">{p.paraQuien}</dd>
                    <dt class="font-semibold text-ink-muted">Idiomas</dt>
                    <dd class="text-ink">{p.idiomas}</dd>
                  </dl>

                  <div>
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Recorrido</h4>
                    <ol class="mt-2 space-y-2">
                      {p.recorrido.map((r, n) => (
                        <li class="flex gap-3 text-sm text-ink">
                          <span class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white ${gold ? 'bg-gold-deep' : 'bg-primary'}`}>{n + 1}</span>
                          <span class="flex-1">{r.lugar}</span>
                          <span class="shrink-0 text-ink-muted">{r.tiempo}</span>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <div class="grid gap-4 sm:grid-cols-2">
                    <div class="rounded-btn bg-sand-deep p-4">
                      <h4 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Incluye</h4>
                      <ul class="mt-2 space-y-1 text-sm text-ink">
                        {p.incluye.map((x) => <li class="flex gap-2"><span class="text-primary">✓</span><span>{x}</span></li>)}
                      </ul>
                    </div>
                    <div class="rounded-btn bg-sand-deep p-4">
                      <h4 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">No incluye (en general)</h4>
                      <ul class="mt-2 space-y-1 text-sm text-ink">
                        {p.noIncluye.map((x) => <li class="flex gap-2"><span class="text-ink-muted">–</span><span>{x}</span></li>)}
                      </ul>
                    </div>
                  </div>

                  <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
                    <dt class="font-semibold text-ink-muted">Mejor época</dt>
                    <dd class="text-ink">{p.mejorEpoca}</dd>
                    <dt class="font-semibold text-ink-muted">Días a evitar</dt>
                    <dd class="text-ink">{p.diasAEvitar}</dd>
                  </dl>

                  <div>
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Notas prácticas</h4>
                    <ul class="mt-2 space-y-1 text-sm text-ink">
                      {p.notas.map((x) => <li class="flex gap-2"><span class="text-ink-muted">·</span><span>{x}</span></li>)}
                    </ul>
                  </div>

                  <div class="rounded-btn border border-primary/40 bg-primary-soft p-4">
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-primary">Referencia de mercado (tours de grupo, publicados)</h4>
                    <p class="mt-2 text-sm font-semibold text-ink">{p.referencia.grupal}</p>
                    {p.referencia.privadoPublicado && (
                      <p class="mt-1 text-sm text-ink">
                        <strong>Privado, publicado por operadores:</strong> {p.referencia.privadoPublicado}
                      </p>
                    )}
                    <p class="mt-2 text-xs text-ink-muted">{p.referencia.fuentes}</p>
                  </div>

                  <div class="rounded-btn border-2 border-gold bg-gold/10 p-4">
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-gold-deep">Para que complete Mari</h4>
                    <dl class="mt-3 space-y-4">
                      {CAMPOS_MARI.map((campo) => (
                        <div>
                          <dt class="text-sm text-ink">{campo}</dt>
                          <dd class="mt-1 h-7 border-b border-dotted border-ink-muted" aria-label="campo vacío" />
                        </div>
                      ))}
                    </dl>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- Preguntas -->
    <section class="mt-16">
      <p class="eyebrow">Tercero</p>
      <h2 class="font-display text-2xl font-bold text-ink">Preguntas para Mari</h2>
      <ol class="mt-6 space-y-3">
        {
          PREGUNTAS_MARI.map((q, i) => (
            <li class="rounded-card border border-gold bg-card p-4 shadow-card">
              <div class="flex gap-4">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-deep font-display text-sm font-bold text-white">{i + 1}</span>
                <p class="text-ink">{q}</p>
              </div>
              <div class="mt-3 space-y-3 ps-12">
                <div class="h-6 border-b border-dotted border-ink-muted" />
                <div class="h-6 border-b border-dotted border-ink-muted" />
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <footer class="mt-12 border-t border-border pt-4 text-xs text-ink-muted">
      <p>
        Página privada de visitisrael.site: no aparece en Google ni en el menú del sitio.
        <a href="/mariluz" class="text-primary">Volver a la propuesta</a>.
      </p>
    </footer>
  </article>
</InternalLayout>
