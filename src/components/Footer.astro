---
import { REGIONS } from '@/data/regions';
import { getLocaleFromPath, localePrefix, useTranslations, PAGE_GROUPS } from '@/i18n/ui';
export interface Props {
  year: number;
}
const { year } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const prefix = localePrefix(locale);

const planning = [
  ...PAGE_GROUPS.practical.map((p) => ({ href: `${prefix}/${p.slug}`, label: t(p.key) })),
  { href: `${prefix}/itineraries`, label: t('nav.itineraries') },
];
const stayTours = [...PAGE_GROUPS.stay, ...PAGE_GROUPS.tours].map((p) => ({
  href: `${prefix}/${p.slug}`,
  label: t(p.key),
}));
// Legal pages are English-only.
const about = [
  { href: '/about', label: 'About us' },
  { href: '/contact', label: 'Contact' },
  { href: '/affiliate-disclosure', label: 'Affiliate disclosure' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/accessibility-statement', label: 'Accessibility' },
];
const columns = [
  { heading: t('nav.regions'), links: REGIONS.map((r) => ({ href: `${prefix}/${r.slug}`, label: r.name })) },
  { heading: t('footer.planning'), links: planning },
  { heading: t('footer.stayTours'), links: stayTours },
  { heading: t('footer.about'), links: about },
];
---

<footer class="mt-20 border-t border-border bg-sand-deep">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-5">
    <div>
      <p class="font-display text-lg font-bold text-ink">
        Visit<span class="text-primary">Israel</span>
      </p>
      <p class="mt-2 text-sm text-ink-muted">{t('footer.tagline')}</p>
    </div>

    {
      columns.map((col) => (
        <div>
          <h2 class="text-sm font-bold uppercase tracking-wide text-ink">{col.heading}</h2>
          <ul class="mt-3 space-y-1.5">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-ink-muted no-underline hover:text-primary">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 pb-6 pt-4 text-xs text-ink-muted">
      &copy; {year} VisitIsrael.site &middot; {t('footer.copyright')}
    </p>
  </div>
</footer>
