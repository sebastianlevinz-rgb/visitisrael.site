---
import { regionBlurb, regionName, regionTagline, type Region } from '@/data/regions';
import { fill, getLocaleFromPath, useTranslations, type Locale } from '@/i18n/ui';
import Pic from '@/components/Pic.astro';
export interface Props {
  region: Region;
  /** First row of cards can eager-load for a faster LCP; rest lazy. */
  eager?: boolean;
  /** Optional href override — defaults to /{region.slug}. */
  href?: string;
  /** Locale for name/tagline/blurb; defaults to the locale of the current URL. */
  locale?: Locale;
}
const { region, eager = false, href, locale = getLocaleFromPath(Astro.url.pathname) } = Astro.props;
const t = useTranslations(locale);
const name = regionName(region, locale);
const tagline = regionTagline(region, locale);
const blurb = regionBlurb(region, locale);
---

{/* Below `sm`: photo on top, copy in a white card. From `sm`: copy overlaid on the photo. */}
<a
  href={href ?? `/${region.slug}`}
  class="group block overflow-hidden rounded-card bg-card shadow-card transition-shadow duration-300 hover:shadow-card-hover sm:relative sm:aspect-[3/4] sm:bg-transparent"
>
  <div class="img-zoom relative aspect-[4/3] sm:absolute sm:inset-0 sm:aspect-auto">
    <Pic
      src={region.hero}
      alt={fill(t('card.imgAlt'), { name, tagline })}
      width="1600"
      height="1000"
      loading={eager ? 'eager' : 'lazy'}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      class="h-full w-full object-cover"
    />
    <div class="photo-overlay absolute inset-0 hidden sm:block"></div>
  </div>
  <div
    class="p-4 sm:absolute sm:inset-x-0 sm:bottom-0 sm:p-5 sm:text-white sm:[text-shadow:0_2px_12px_rgb(0_0_0/0.55),0_1px_3px_rgb(0_0_0/0.6)]"
  >
    <p class="text-xs font-semibold uppercase tracking-widest text-primary sm:text-inherit sm:opacity-90">
      {tagline}
    </p>
    <h3 class="mt-1 font-display text-xl font-bold text-ink sm:text-2xl sm:text-inherit">
      {name}
    </h3>
    <p class="mt-1.5 line-clamp-2 text-sm leading-snug text-ink-muted sm:line-clamp-none sm:text-inherit sm:opacity-95">
      {blurb}
    </p>
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primary sm:text-inherit">
      {t('card.explore')}
      <svg
        class="h-4 w-4 transition-transform group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z"
          clip-rule="evenodd"></path>
      </svg>
    </span>
  </div>
</a>
