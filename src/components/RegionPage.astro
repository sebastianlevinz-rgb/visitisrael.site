---
/**
 * Region page body, shared by the en/fr/de/es/he routes (src/pages/[region]/index.astro
 * and src/pages/{fr,de,es,he}/[region]/index.astro). The routes used to be
 * near-identical 240-line copies that only differed in their strings.
 *
 * Curated key facts, tours and hotels come from src/data/regionData.ts, which is
 * English-only for now — localized pages show them in English (known gap).
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import KeyFacts from '@/components/KeyFacts.astro';
import AffiliateCard from '@/components/AffiliateCard.astro';
import HotelCard from '@/components/HotelCard.astro';
import Stay22Map from '@/components/Stay22Map.astro';
import BestTimeTable from '@/components/BestTimeTable.astro';
import DestinationCard from '@/components/DestinationCard.astro';
import FaqSection from '@/components/FaqSection.astro';
import JsonLd from '@/components/JsonLd.astro';
import { REGIONS, getRegion } from '@/data/regions';
import { REGION_DATA, genericRegionData } from '@/data/regionData';
import { defaultAuthor } from '@/data/authors';
import { affiliateUrl } from '@/config/affiliates';
import { place, article, breadcrumbList, hotelList } from '@/lib/schema';
import { locales, localeHome, localePrefix, entryIdFor, alternatesFor, type Locale } from '@/i18n/ui';

interface Props {
  entry: CollectionEntry<'regions'>;
  slug: string;
  locale: Locale;
}
const { entry, slug, locale } = Astro.props;

const STRINGS = {
  en: {
    home: 'Home',
    country: 'Israel',
    glance: (n: string) => `${n} at a glance`,
    toursKicker: 'Hand-picked',
    toursTitle: (n: string) => `Best tours & day trips in ${n}`,
    stayKicker: 'Where to stay',
    stayTitle: (n: string) => `Best places to stay in ${n}`,
    stayGuide: (n: string) => `Full guide: best hotels in ${n} →`,
    stayFallback: (n: string) => `Compare hotels, guesthouses and apartments across ${n} on Booking.com.`,
    stayCta: (n: string) => `Find hotels in ${n}`,
    bestTime: (n: string) => `Best time to visit ${n}`,
    guide: (n: string) => `The complete ${n} guide`,
    essentials: 'Plan the practical stuff',
    related: 'Explore more of Israel',
    links: ['First time in Israel', 'Visa & ETA', 'Best time to visit', 'Car rental', 'Jerusalem tours', 'Day trips from Tel Aviv'],
  },
  fr: {
    home: 'Accueil',
    country: 'Israël',
    glance: (n: string) => `${n} en un clin d'œil`,
    toursKicker: 'Sélection',
    toursTitle: (n: string) => `Meilleurs circuits & excursions à ${n}`,
    stayKicker: 'Hébergement',
    stayTitle: (n: string) => `Où dormir à ${n}`,
    stayGuide: (n: string) => `Guide complet : meilleurs hôtels à ${n} →`,
    stayFallback: (n: string) => `Comparez hôtels, guesthouses et appartements à ${n} sur Booking.com.`,
    stayCta: (n: string) => `Trouver un hôtel à ${n}`,
    bestTime: (n: string) => `Meilleure période pour visiter ${n}`,
    guide: (n: string) => `Le guide complet de ${n}`,
    essentials: 'Préparer votre voyage',
    related: "Explorer d'autres régions",
    links: ['Premier voyage en Israël', 'Visa & ETA', 'Meilleure période', 'Location voiture', 'Circuits à Jérusalem', 'Excursions depuis Tel Aviv'],
  },
  de: {
    home: 'Startseite',
    country: 'Israel',
    glance: (n: string) => `${n} auf einen Blick`,
    toursKicker: 'Unsere Empfehlung',
    toursTitle: (n: string) => `Beste Touren & Ausflüge in ${n}`,
    stayKicker: 'Unterkunft',
    stayTitle: (n: string) => `Wo übernachten in ${n}`,
    stayGuide: (n: string) => `Vollständiger Guide: die besten Hotels in ${n} →`,
    stayFallback: (n: string) => `Vergleichen Sie Hotels, Gästehäuser und Apartments in ${n} auf Booking.com.`,
    stayCta: (n: string) => `Hotel in ${n} finden`,
    bestTime: (n: string) => `Beste Reisezeit für ${n}`,
    guide: (n: string) => `Der vollständige Reiseführer für ${n}`,
    essentials: 'Reise planen',
    related: 'Weitere Regionen entdecken',
    links: ['Erste Israel-Reise', 'Visum & ETA', 'Beste Reisezeit', 'Mietwagen', 'Touren in Jerusalem', 'Ausflüge ab Tel Aviv'],
  },
  es: {
    home: 'Inicio',
    country: 'Israel',
    glance: (n: string) => `${n} de un vistazo`,
    toursKicker: 'Selección',
    toursTitle: (n: string) => `Mejores tours y excursiones en ${n}`,
    stayKicker: 'Alojamiento',
    stayTitle: (n: string) => `Dónde dormir en ${n}`,
    stayGuide: (n: string) => `Guía completa: mejores hoteles en ${n} →`,
    stayFallback: (n: string) => `Compara hoteles, pensiones y apartamentos en ${n} en Booking.com.`,
    stayCta: (n: string) => `Buscar hotel en ${n}`,
    bestTime: (n: string) => `Mejor época para visitar ${n}`,
    guide: (n: string) => `Guía completa de ${n}`,
    essentials: 'Planifica tu viaje',
    related: 'Explorar otras regiones',
    links: ['Primer viaje a Israel', 'Visado y ETA', 'Mejor época', 'Alquiler de coche', 'Tours en Jerusalén', 'Excursiones desde Tel Aviv'],
  },
  he: {
    home: 'דף הבית',
    country: 'ישראל',
    glance: (n: string) => `${n} במבט מהיר`,
    toursKicker: 'הבחירות שלנו',
    toursTitle: (n: string) => `הסיורים וטיולי היום הטובים ביותר ב${n}`,
    stayKicker: 'איפה לישון',
    stayTitle: (n: string) => `המקומות הטובים ביותר ללינה ב${n}`,
    // Trailing arrow points in the reading direction (left in RTL).
    stayGuide: (n: string) => `המדריך המלא: המלונות הטובים ביותר ב${n} ←`,
    stayFallback: (n: string) => `השוו מלונות, צימרים ודירות ב${n} ב-Booking.com.`,
    stayCta: (n: string) => `חיפוש מלונות ב${n}`,
    bestTime: (n: string) => `מתי כדאי לבקר ב${n}`,
    guide: (n: string) => `המדריך המלא ל${n}`,
    essentials: 'תכננו את הצד המעשי',
    related: 'עוד מקומות בישראל',
    links: ['פעם ראשונה בישראל', 'ויזה ו-ETA', 'מתי כדאי לבקר', 'השכרת רכב', 'סיורים בירושלים', 'טיולי יום מתל אביב'],
  },
} as const satisfies Record<Locale, unknown>;
const s = STRINGS[locale];
const prefix = localePrefix(locale);

// src/data/regions.ts is English-only. Hebrew is the one locale where a Latin
// region name breaks the sentence (the ב/ל prefixes glue onto the word), so the
// region page uses the Hebrew endonym for its own headings, hero and breadcrumb.
// Header, footer and destination cards still show the English name (known gap).
const HE_REGION_NAMES: Record<string, string> = {
  jerusalem: 'ירושלים',
  'tel-aviv': 'תל אביב',
  'dead-sea': 'ים המלח',
  galilee: 'הגליל',
  eilat: 'אילת',
  negev: 'הנגב',
  haifa: 'חיפה',
};

const meta = getRegion(slug);
const name = (locale === 'he' ? HE_REGION_NAMES[slug] : undefined) ?? meta?.name ?? entry.data.title;
const tagline = meta?.tagline ?? '';
const hero = meta?.hero ?? entry.data.heroImage;
const data = REGION_DATA[slug] ?? genericRegionData(slug, name, hero);
const intro = locale === 'en' ? (data.intro ?? entry.data.description) : entry.data.description;
const { Content } = await render(entry);
const path = `${prefix}/${slug}`;
const homePath = localeHome(locale);

// Hotel guides that exist for a region (kept pages of the rebuild).
const STAY_GUIDES: Record<string, string> = {
  jerusalem: 'best-hotels-jerusalem',
  'tel-aviv': 'best-hotels-tel-aviv',
  'dead-sea': 'dead-sea-hotels-guide',
};
const stayGuide = STAY_GUIDES[slug];

const essentialSlugs = [
  'first-time-in-israel',
  'visa-information',
  'best-time-to-visit-israel',
  'car-rental-israel',
  'jerusalem-tours-compared',
  'day-trips-from-tel-aviv',
];
const essentials = essentialSlugs.map((g, i) => ({ href: `${prefix}/${g}`, label: s.links[i] }));

// hreflang from the region entries that actually exist (every locale, he included).
const regionIds = new Set((await getCollection('regions')).map((e) => e.id));
const alternates = alternatesFor(
  slug,
  locales.filter((l) => regionIds.has(entryIdFor(l, slug)))
);

const related = REGIONS.filter((r) => r.slug !== slug).slice(0, 3);
const crumbs = [
  { name: s.home, path: homePath },
  { name, path },
];

const schema = [
  place({
    type: 'TouristDestination',
    name,
    description: entry.data.description,
    image: hero,
    path,
    latitude: entry.data.latitude,
    longitude: entry.data.longitude,
  }),
  article({
    headline: entry.data.title,
    description: entry.data.description,
    image: hero,
    path,
    authorName: defaultAuthor.name,
    authorUrl: defaultAuthor.url,
    datePublished: entry.data.publishedAt,
    dateModified: entry.data.updatedAt,
  }),
  breadcrumbList(crumbs),
  ...(data.hotels.length ? [hotelList(data.hotels.map((h) => ({ name: h.name, url: path })), name)] : []),
];
---

<BaseLayout title={entry.data.title} description={entry.data.description} path={path} image={hero} alternates={alternates}>
  <JsonLd slot="head" schema={schema} />

  <Hero image={hero} title={name} subtitle={tagline} alt={`${name}, ${s.country}`} height="tall" />
  <Breadcrumbs items={crumbs} />
  <AuthorByline updated={entry.data.updatedAt} />

  <section class="mx-auto max-w-3xl px-4">
    <p class="text-lg leading-relaxed text-ink">{intro}</p>
    <KeyFacts facts={data.keyFacts} title={s.glance(name)} />
  </section>

  <section id="tours" class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="featured-tours">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">{s.toursKicker}</p>
    <h2 id="featured-tours" class="mb-5 font-display text-3xl font-bold text-ink">{s.toursTitle(name)}</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {data.tours.map((t) => <AffiliateCard {...t} />)}
    </div>
  </section>

  <section id="where-to-stay" class="mx-auto max-w-6xl px-4 pt-14" aria-labelledby="stay">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">{s.stayKicker}</p>
    <h2 id="stay" class="mb-5 font-display text-3xl font-bold text-ink">{s.stayTitle(name)}</h2>
    {
      stayGuide && (
        <p class="-mt-2 mb-5 text-sm">
          <a href={`${prefix}/${stayGuide}`} class="font-semibold text-primary">{s.stayGuide(name)}</a>
        </p>
      )
    }
    {
      data.hotels.length > 0 ? (
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {data.hotels.slice(0, 4).map((h) => (
              <HotelCard hotel={h} regionName={name} />
            ))}
          </div>
          {entry.data.latitude && entry.data.longitude && (
            <Stay22Map lat={entry.data.latitude} lng={entry.data.longitude} label={name} />
          )}
        </div>
      ) : (
        <div class="rounded-card border border-border bg-card p-6 shadow-card">
          <p class="text-ink-muted">{s.stayFallback(name)}</p>
          <a
            href={affiliateUrl('booking', { destination: `${name}, Israel` })}
            target="_blank"
            rel="sponsored nofollow noopener"
            class="mt-3 inline-block rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline hover:bg-primary-hover"
          >
            {s.stayCta(name)}
          </a>
        </div>
      )
    }
  </section>

  {
    data.bestTime && (
      <section class="mx-auto max-w-3xl px-4 pt-14" aria-labelledby="best-time">
        <h2 id="best-time" class="mb-4 font-display text-3xl font-bold text-ink">{s.bestTime(name)}</h2>
        <BestTimeTable rows={data.bestTime} />
      </section>
    )
  }

  <article class="prose-content mx-auto max-w-3xl px-4 pt-14">
    <h2 class="font-display !text-3xl">{s.guide(name)}</h2>
    <Content />
  </article>

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="essentials">
    <h2 id="essentials" class="mb-5 font-display text-2xl font-bold text-ink">{s.essentials}</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        essentials.map((e) => (
          <a
            href={e.href}
            class="rounded-card border border-border bg-card p-4 text-center text-sm font-semibold text-ink no-underline shadow-card transition-shadow hover:shadow-card-hover"
          >
            {e.label}
          </a>
        ))
      }
    </div>
  </section>

  <FaqSection faqs={entry.data.faqs ?? []} />

  <section class="mx-auto max-w-6xl px-4 pb-4" aria-labelledby="related">
    <h2 id="related" class="mb-5 font-display text-3xl font-bold text-ink">{s.related}</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      {related.map((r) => <DestinationCard region={r} href={`${prefix}/${r.slug}`} />)}
    </div>
  </section>

  <AuthorByline updated={entry.data.updatedAt} />
</BaseLayout>
