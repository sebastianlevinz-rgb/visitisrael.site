---
/**
 * Home page for the fr/de/es/he locales (src/pages/{fr,de,es,he}/index.astro). Every
 * page linked here exists in the locale, so there is no "English only" notice.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import DestinationCard from '@/components/DestinationCard.astro';
import { REGIONS } from '@/data/regions';
import { useTranslations, homeAlternates, localePrefix, PAGE_GROUPS, type Locale } from '@/i18n/ui';
import { creditFor } from '@/lib/photos';

const HOME_HERO = '/images/regions/jerusalem/hero.jpg';

interface Props {
  locale: Exclude<Locale, 'en'>;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = localePrefix(locale);

const META = {
  fr: {
    title: 'Voyage en Israël : guide de voyage, itinéraires et hôtels',
    description:
      'Voyage en Israël : 7 régions de Jérusalem à la mer Rouge, itinéraires, meilleurs hôtels et circuits comparés, avec des liens de réservation bien signalés.',
    alt: "Vue de la vieille ville de Jérusalem à l'heure dorée",
  },
  de: {
    title: 'Israel-Reise planen: Reiseführer, Routen, Hotels & Touren',
    description:
      'Israel-Reise planen: 7 Regionen von Jerusalem bis zum Roten Meer, Reiserouten, beste Hotels und Touren im Vergleich, mit klar markierten Buchungslinks.',
    alt: 'Blick auf die Altstadt von Jerusalem zur goldenen Stunde',
  },
  es: {
    title: 'Viajar a Israel: guía de viaje, rutas, hoteles y tours',
    description:
      'Viajar a Israel: 7 regiones desde Jerusalén hasta el mar Rojo, itinerarios, los mejores hoteles y tours comparados, con enlaces de reserva bien señalados.',
    alt: 'Vista de la Ciudad Vieja de Jerusalén a la hora dorada',
  },
  he: {
    title: 'טיול בישראל: מדריך טיולים, מסלולים, מלונות וסיורים',
    description:
      'תכננו טיול בישראל: 7 אזורים מירושלים ועד ים סוף, מסלולי טיול, המלונות והסיורים הטובים ביותר בהשוואה, עם קישורי הזמנה מסומנים בבירור.',
    alt: 'מבט על העיר העתיקה בירושלים בשעת הזהב',
  },
} as const satisfies Record<Exclude<Locale, 'en'>, { title: string; description: string; alt: string }>;
const meta = META[locale];

// Dense, data-rich intro — the same paragraph the English home carries
// (src/pages/index.astro), with the same four region links. Rendered with set:html.
const link = (slug: string, text: string) => `<a href="${prefix}/${slug}">${text}</a>`;
const INTRO: Record<Exclude<Locale, 'en'>, string> = {
  fr: `<strong>Israël</strong> concentre quatre millénaires d'histoire, trois grandes religions et une étonnante variété de paysages dans un pays à peine plus grand que la Slovénie. En une seule semaine, vous pouvez vous tenir devant le <strong>mur des Lamentations</strong> à ${link('jerusalem', 'Jérusalem')}, nager sur les plages méditerranéennes de ${link('tel-aviv', 'Tel Aviv')}, flotter dans la ${link('dead-sea', 'mer Morte')} — le point le plus bas de la Terre, à 430 m sous le niveau de la mer — et plonger sur les récifs coralliens de la mer Rouge à ${link('eilat', 'Eilat')}. La plupart des visiteurs arrivent à l'aéroport Ben Gourion (TLV), près de Tel Aviv ; de là, trains et bus desservent l'essentiel du pays. Les meilleures périodes sont le printemps (mars–mai) et l'automne (septembre–novembre), quand le temps est doux. Ce guide couvre <strong>7 régions</strong> — Jérusalem, Tel Aviv, la mer Morte, la Galilée, Eilat, le Néguev et Haïfa — avec des itinéraires de 7 et 10 jours, les meilleurs hôtels et circuits comparés, et des conseils pratiques sur les visas, la sécurité et la location de voiture.`,
  de: `<strong>Israel</strong> vereint vier Jahrtausende Geschichte, drei Weltreligionen und eine erstaunliche Vielfalt an Landschaften in einem Land, das nur wenig größer ist als Hessen. In einer einzigen Woche können Sie an der <strong>Klagemauer</strong> in ${link('jerusalem', 'Jerusalem')} stehen, an den Mittelmeerstränden von ${link('tel-aviv', 'Tel Aviv')} baden, im ${link('dead-sea', 'Toten Meer')} treiben — dem tiefsten Punkt der Erde, 430 m unter dem Meeresspiegel — und in ${link('eilat', 'Eilat')} an den Korallenriffen des Roten Meeres tauchen. Die meisten Besucher landen am Flughafen Ben Gurion (TLV) bei Tel Aviv; von dort erreichen Züge und Busse den größten Teil des Landes. Die besten Reisezeiten sind Frühling (März–Mai) und Herbst (September–November), wenn das Wetter mild ist. Dieser Reiseführer deckt <strong>7 Regionen</strong> ab — Jerusalem, Tel Aviv, das Tote Meer, Galiläa, Eilat, den Negev und Haifa — mit Reiserouten für 7 und 10 Tage, den besten Hotels und Touren im Vergleich sowie praktischen Hinweisen zu Visum, Sicherheit und Mietwagen.`,
  es: `<strong>Israel</strong> concentra cuatro milenios de historia, tres grandes religiones y una variedad asombrosa de paisajes en un país poco más grande que Eslovenia. En una sola semana puedes estar frente al <strong>Muro de las Lamentaciones</strong> en ${link('jerusalem', 'Jerusalén')}, nadar en las playas mediterráneas de ${link('tel-aviv', 'Tel Aviv')}, flotar en el ${link('dead-sea', 'Mar Muerto')} — el punto más bajo de la Tierra, a 430 m bajo el nivel del mar — y bucear entre los arrecifes de coral del Mar Rojo en ${link('eilat', 'Eilat')}. La mayoría de los visitantes llega al aeropuerto Ben Gurión (TLV), junto a Tel Aviv; desde allí, trenes y autobuses llegan a casi todo el país. Las mejores épocas son la primavera (marzo–mayo) y el otoño (septiembre–noviembre), cuando el clima es suave. Esta guía cubre <strong>7 regiones</strong> — Jerusalén, Tel Aviv, el Mar Muerto, Galilea, Eilat, el Néguev y Haifa — con itinerarios de 7 y 10 días, los mejores hoteles y tours comparados, y consejos prácticos sobre visados, seguridad y alquiler de coche.`,
  he: `<strong>ישראל</strong> מרכזת ארבעת אלפי שנות היסטוריה, שלוש דתות גדולות ומגוון מרשים של נופים במדינה שאפשר לחצות מצפון לדרום ביום נסיעה אחד. בשבוע אחד אפשר לעמוד ליד <strong>הכותל המערבי</strong> ב${link('jerusalem', 'ירושלים')}, לשחות בחופי הים התיכון של ${link('tel-aviv', 'תל אביב')}, לצוף ב${link('dead-sea', 'ים המלח')} — המקום הנמוך בעולם, 430 מטר מתחת לפני הים — ולצלול בשוניות האלמוגים של ים סוף ב${link('eilat', 'אילת')}. רוב המבקרים מגיעים לנתב״ג (TLV) ליד תל אביב; משם רכבות ואוטובוסים מגיעים לרוב חלקי הארץ. התקופות הטובות ביותר לביקור הן האביב (מרץ–מאי) והסתיו (ספטמבר–נובמבר), כשמזג האוויר נוח. המדריך הזה מכסה <strong>7 אזורים</strong> — ירושלים, תל אביב, ים המלח, הגליל, אילת, הנגב וחיפה — עם מסלולים של 7 ו-10 ימים, המלונות והסיורים הטובים ביותר בהשוואה, ועצות מעשיות על ויזות, ביטחון והשכרת רכב.`,
};

const groups = [
  { heading: t('plan.practicalHeading'), pages: PAGE_GROUPS.practical },
  { heading: t('plan.stayHeading'), pages: PAGE_GROUPS.stay },
  { heading: t('plan.toursHeading'), pages: PAGE_GROUPS.tours },
];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={`${prefix}/`}
  ogImage="/og-default.jpg"
  imageAlt={meta.title}
  alternates={homeAlternates()}
>
  <Hero
    image={HOME_HERO}
    credit={creditFor(HOME_HERO)}
    title={t('home.heroTitle')}
    subtitle={t('home.heroSubtitle')}
    alt={meta.alt}
    cta={{ href: `${prefix}/itineraries`, label: t('nav.itineraries') }}
  />

  <!-- Dense, data-rich intro (same content as the English home). -->
  <section class="mx-auto max-w-3xl px-4 pt-12">
    <p class="text-lg leading-relaxed text-ink" set:html={INTRO[locale]} />
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="regions">
    <h2 id="regions" class="mb-5 font-display text-3xl font-bold text-ink">{t('home.regionsHeading')}</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {REGIONS.map((r, i) => <DestinationCard region={r} eager={i < 4} href={`${prefix}/${r.slug}`} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-14" aria-labelledby="plan">
    <h2 id="plan" class="mb-6 font-display text-3xl font-bold text-ink">{t('home.planHeading')}</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {
        groups.map((g) => (
          <div class="rounded-card border border-border bg-card p-5 shadow-card">
            <h3 class="font-display text-lg font-bold text-ink">{g.heading}</h3>
            <ul class="mt-3 space-y-1.5">
              {g.pages.map((p) => (
                <li>
                  <a href={`${prefix}/${p.slug}`} class="text-sm font-semibold text-primary no-underline hover:underline">
                    {t(p.key)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14 text-center">
    <a
      href={`${prefix}/itineraries`}
      class="me-2 inline-block rounded-full border border-primary px-6 py-3 text-sm font-semibold text-primary no-underline transition-colors hover:bg-primary-soft"
    >
      {t('nav.itineraries')}
    </a>
    <a
      href={`${prefix}/plan-your-trip`}
      class="inline-block rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
    >
      {t('nav.plan')}
    </a>
  </section>
</BaseLayout>
