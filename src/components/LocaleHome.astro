---
/**
 * Home page for the fr/de/es/he locales (src/pages/{fr,de,es,he}/index.astro). Every
 * page linked here exists in the locale, so there is no "English only" notice.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import DestinationCard from '@/components/DestinationCard.astro';
import FaqSection from '@/components/FaqSection.astro';
import { REGIONS } from '@/data/regions';
import { useTranslations, homeAlternates, localePrefix, PAGE_GROUPS, type Locale } from '@/i18n/ui';
import { creditFor } from '@/lib/photos';
import type { Faq } from '@/lib/schema';

const HOME_HERO = '/images/regions/jerusalem/hero.jpg';

interface Props {
  locale: Exclude<Locale, 'en'>;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = localePrefix(locale);

const META = {
  fr: {
    title: 'Voyage en Israël : guide de voyage, itinéraires et hôtels',
    description:
      'Voyage en Israël : 7 régions de Jérusalem à la mer Rouge, itinéraires, meilleurs hôtels et circuits comparés, avec des liens de réservation bien signalés.',
    alt: "Vue de la vieille ville de Jérusalem à l'heure dorée",
  },
  de: {
    title: 'Israel-Reise planen: Reiseführer, Routen, Hotels & Touren',
    description:
      'Israel-Reise planen: 7 Regionen von Jerusalem bis zum Roten Meer, Reiserouten, beste Hotels und Touren im Vergleich, mit klar markierten Buchungslinks.',
    alt: 'Blick auf die Altstadt von Jerusalem zur goldenen Stunde',
  },
  es: {
    title: 'Viajar a Israel: guía de viaje, rutas, hoteles y tours',
    description:
      'Viajar a Israel: 7 regiones desde Jerusalén hasta el mar Rojo, itinerarios, los mejores hoteles y tours comparados, con enlaces de reserva bien señalados.',
    alt: 'Vista de la Ciudad Vieja de Jerusalén a la hora dorada',
  },
  he: {
    title: 'טיול בישראל: מדריך טיולים, מסלולים, מלונות וסיורים',
    description:
      'תכננו טיול בישראל: 7 אזורים מירושלים ועד ים סוף, מסלולי טיול, המלונות והסיורים הטובים ביותר בהשוואה, עם קישורי הזמנה מסומנים בבירור.',
    alt: 'מבט על העיר העתיקה בירושלים בשעת הזהב',
  },
} as const satisfies Record<Exclude<Locale, 'en'>, { title: string; description: string; alt: string }>;
const meta = META[locale];

// Dense, data-rich intro — the same paragraph the English home carries
// (src/pages/index.astro), with the same four region links. Rendered with set:html.
const link = (slug: string, text: string) => `<a href="${prefix}/${slug}">${text}</a>`;
const INTRO: Record<Exclude<Locale, 'en'>, string> = {
  fr: `<strong>Israël</strong> concentre quatre millénaires d'histoire, trois grandes religions et une étonnante variété de paysages dans un pays à peine plus grand que la Slovénie. En une seule semaine, vous pouvez vous tenir devant le <strong>mur des Lamentations</strong> à ${link('jerusalem', 'Jérusalem')}, nager sur les plages méditerranéennes de ${link('tel-aviv', 'Tel Aviv')}, flotter dans la ${link('dead-sea', 'mer Morte')} — le point le plus bas de la Terre, à 430 m sous le niveau de la mer — et plonger sur les récifs coralliens de la mer Rouge à ${link('eilat', 'Eilat')}. La plupart des visiteurs arrivent à l'aéroport Ben Gourion (TLV), près de Tel Aviv ; de là, trains et bus desservent l'essentiel du pays. Les meilleures périodes sont le printemps (mars–mai) et l'automne (septembre–novembre), quand le temps est doux. Ce guide couvre <strong>7 régions</strong> — Jérusalem, Tel Aviv, la mer Morte, la Galilée, Eilat, le Néguev et Haïfa — avec des itinéraires de 7 et 10 jours, les meilleurs hôtels et circuits comparés, et des conseils pratiques sur les visas, la sécurité et la location de voiture.`,
  de: `<strong>Israel</strong> vereint vier Jahrtausende Geschichte, drei Weltreligionen und eine erstaunliche Vielfalt an Landschaften in einem Land, das nur wenig größer ist als Hessen. In einer einzigen Woche können Sie an der <strong>Klagemauer</strong> in ${link('jerusalem', 'Jerusalem')} stehen, an den Mittelmeerstränden von ${link('tel-aviv', 'Tel Aviv')} baden, im ${link('dead-sea', 'Toten Meer')} treiben — dem tiefsten Punkt der Erde, 430 m unter dem Meeresspiegel — und in ${link('eilat', 'Eilat')} an den Korallenriffen des Roten Meeres tauchen. Die meisten Besucher landen am Flughafen Ben Gurion (TLV) bei Tel Aviv; von dort erreichen Züge und Busse den größten Teil des Landes. Die besten Reisezeiten sind Frühling (März–Mai) und Herbst (September–November), wenn das Wetter mild ist. Dieser Reiseführer deckt <strong>7 Regionen</strong> ab — Jerusalem, Tel Aviv, das Tote Meer, Galiläa, Eilat, den Negev und Haifa — mit Reiserouten für 7 und 10 Tage, den besten Hotels und Touren im Vergleich sowie praktischen Hinweisen zu Visum, Sicherheit und Mietwagen.`,
  es: `<strong>Israel</strong> concentra cuatro milenios de historia, tres grandes religiones y una variedad asombrosa de paisajes en un país poco más grande que Eslovenia. En una sola semana puedes estar frente al <strong>Muro de las Lamentaciones</strong> en ${link('jerusalem', 'Jerusalén')}, nadar en las playas mediterráneas de ${link('tel-aviv', 'Tel Aviv')}, flotar en el ${link('dead-sea', 'Mar Muerto')} — el punto más bajo de la Tierra, a 430 m bajo el nivel del mar — y bucear entre los arrecifes de coral del Mar Rojo en ${link('eilat', 'Eilat')}. La mayoría de los visitantes llega al aeropuerto Ben Gurión (TLV), junto a Tel Aviv; desde allí, trenes y autobuses llegan a casi todo el país. Las mejores épocas son la primavera (marzo–mayo) y el otoño (septiembre–noviembre), cuando el clima es suave. Esta guía cubre <strong>7 regiones</strong> — Jerusalén, Tel Aviv, el Mar Muerto, Galilea, Eilat, el Néguev y Haifa — con itinerarios de 7 y 10 días, los mejores hoteles y tours comparados, y consejos prácticos sobre visados, seguridad y alquiler de coche.`,
  he: `<strong>ישראל</strong> מרכזת ארבעת אלפי שנות היסטוריה, שלוש דתות גדולות ומגוון מרשים של נופים במדינה שאפשר לחצות מצפון לדרום ביום נסיעה אחד. בשבוע אחד אפשר לעמוד ליד <strong>הכותל המערבי</strong> ב${link('jerusalem', 'ירושלים')}, לשחות בחופי הים התיכון של ${link('tel-aviv', 'תל אביב')}, לצוף ב${link('dead-sea', 'ים המלח')} — המקום הנמוך בעולם, 430 מטר מתחת לפני הים — ולצלול בשוניות האלמוגים של ים סוף ב${link('eilat', 'אילת')}. רוב המבקרים מגיעים לנתב״ג (TLV) ליד תל אביב; משם רכבות ואוטובוסים מגיעים לרוב חלקי הארץ. התקופות הטובות ביותר לביקור הן האביב (מרץ–מאי) והסתיו (ספטמבר–נובמבר), כשמזג האוויר נוח. המדריך הזה מכסה <strong>7 אזורים</strong> — ירושלים, תל אביב, ים המלח, הגליל, אילת, הנגב וחיפה — עם מסלולים של 7 ו-10 ימים, המלונות והסיורים הטובים ביותר בהשוואה, ועצות מעשיות על ויזות, ביטחון והשכרת רכב.`,
};

const groups = [
  { heading: t('plan.practicalHeading'), pages: PAGE_GROUPS.practical },
  { heading: t('plan.stayHeading'), pages: PAGE_GROUPS.stay },
  { heading: t('plan.toursHeading'), pages: PAGE_GROUPS.tours },
];

/**
 * "Plan an Israel trip: the essentials" + home FAQ — the same six blocks and five
 * questions the English home carries (src/pages/index.astro), translated per locale.
 * Editorial copy only; every fact comes from the English version. All six linked
 * guides exist in the four locales, so every href takes the locale prefix.
 */
interface Essential {
  heading: string;
  text: string;
  href: string;
  cta: string;
}
interface HomeCopy {
  essentialsEyebrow: string;
  essentialsHeading: string;
  essentialsIntro: string;
  essentials: Essential[];
  faqs: Faq[];
}

const COPY = {
  fr: {
    essentialsEyebrow: 'Avant de réserver',
    essentialsHeading: 'Préparer un voyage en Israël : l’essentiel',
    essentialsIntro:
      'Les six questions que se pose tout visiteur qui vient pour la première fois, chacune traitée en un paragraphe. Les guides liés donnent le détail et sont mis à jour au fil des changements de règles.',
    essentials: [
      {
        heading: 'Quand partir',
        text: 'Le printemps (de mars à mai) et l’automne (de septembre à novembre) sont les deux périodes qui conviennent partout dans le pays : journées chaudes et sèches à Jérusalem et en Galilée, mer assez chaude pour se baigner à Tel Aviv, chaleur supportable à la mer Morte et dans le Néguev. L’été est très chaud dans le sud et dans le désert de Judée, mais agréable sur la côte ; l’hiver est doux et pluvieux dans le nord, et plaisant à Eilat. Ces deux intersaisons coïncident aussi avec les grandes fêtes juives, pendant lesquelles les hôtels se remplissent et les prix montent : consultez le calendrier avant de fixer vos dates.',
        href: `${prefix}/best-time-to-visit-israel`,
        cta: 'Meilleure période pour visiter Israël',
      },
      {
        heading: 'Entrée : visa et ETA-IL',
        text: 'Les ressortissants de la plupart des pays occidentaux n’ont pas besoin de visa pour un séjour touristique de 90 jours au maximum, mais les voyageurs exemptés de visa doivent désormais obtenir en ligne une autorisation électronique de voyage ETA-IL avant de prendre l’avion : faites la demande quelques jours à l’avance, pas à l’aéroport. À l’arrivée, vous recevez un petit coupon d’entrée à la place d’un tampon sur le passeport ; conservez-le, les hôtels et le passage vers Bethléem le demandent. Le passeport doit rester valable au moins six mois après la fin du séjour. Les règles évoluent : vérifiez votre nationalité sur le portail officiel avant de réserver.',
        href: `${prefix}/visa-information`,
        cta: 'Visa pour Israël et ETA-IL : le guide',
      },
      {
        heading: 'Se déplacer',
        text: 'Israël est un petit pays : le train relie l’aéroport Ben Gourion à Tel Aviv en 20 minutes environ et à Jérusalem en 30, et les bus interurbains desservent presque toutes les villes. Une seule carte sans contact ou application couvre les trains, les bus et le tramway de Jérusalem. Le piège, c’est le shabbat : du vendredi après-midi au samedi soir, les transports publics s’arrêtent dans tout le pays, et seuls les taxis collectifs (sheruts) et les taxis privés circulent. La voiture de location se justifie en Galilée, sur le Golan et dans le Néguev, où les sites sont dispersés ; elle devient un fardeau à Tel Aviv et à Jérusalem, où le stationnement est rare.',
        href: `${prefix}/car-rental-israel`,
        cta: 'Louer une voiture en Israël : quand ça vaut le coup',
      },
      {
        heading: 'Argent et budget',
        text: 'La monnaie est le nouveau shekel israélien (ILS, noté ₪). Cartes et paiement sans contact sont acceptés presque partout, jusque sur les étals des marchés et dans les taxis, donc peu d’espèces sont nécessaires ; les distributeurs abondent en ville. Attendez-vous à des prix comparables à ceux de l’Europe de l’Ouest : l’hébergement et les restaurants sont les gros postes, tandis que transports publics, déjeuner de houmous et sites gratuits de la vieille ville gardent une journée bon marché si vous le souhaitez. Le pourboire au restaurant est d’usage, en espèces ou ajouté sur la carte à votre demande. Excursions guidées et petits-déjeuners d’hôtel sont les postes où l’on dépense le plus facilement trop.',
        href: `${prefix}/first-time-in-israel`,
        cta: 'Première fois en Israël : les bases',
      },
      {
        heading: 'Sécurité',
        text: 'Israël reçoit des millions de visiteurs par an, et le circuit touristique (Jérusalem, Tel Aviv, la mer Morte, la Galilée, Eilat) fonctionne avec des contrôles de sécurité de routine dans les gares, les centres commerciaux et les lieux saints. Les risques du quotidien sont les risques ordinaires : pickpockets dans les marchés bondés, insolation dans le désert, et fermetures du shabbat qui vous prennent au dépourvu. La situation régionale peut changer vite : lisez les conseils aux voyageurs actuels de votre gouvernement avant de réserver, relisez-les la semaine du départ et gardez votre assurance voyage à jour. Notre guide sécurité suit ces conseils et explique ce qu’ils signifient en pratique.',
        href: `${prefix}/is-israel-safe`,
        cta: 'Israël est-il un pays sûr pour voyager ?',
      },
      {
        heading: 'Combien de jours',
        text: 'Un premier voyage demande une semaine. Sept jours couvrent l’essentiel sans courir : trois nuits à Jérusalem avec une journée à la mer Morte et à Massada, trois à Tel Aviv avec une excursion vers le nord (Césarée, Haïfa ou la Galilée), et le train entre les deux. Dix jours permettent d’ajouter vraiment le nord (Nazareth, le lac de Tibériade, le Golan) et l’extrême sud, avec Eilat et, en option, une journée à Pétra de l’autre côté de la frontière. Avec moins de cinq jours, il faut choisir entre Jérusalem et Tel Aviv ; les deux en quatre jours restent possibles, mais sans la mer Morte.',
        href: `${prefix}/itineraries`,
        cta: 'Itinéraires de 7 et 10 jours',
      },
    ],
    faqs: [
      {
        question: 'Faut-il un visa pour visiter Israël ?',
        answer:
          'La plupart des visiteurs venant d’Amérique du Nord, d’Europe, d’Australie et de nombreux autres pays entrent sans visa pour 90 jours au maximum, mais depuis la mise en place du système ETA-IL, les voyageurs exemptés de visa doivent obtenir une autorisation électronique de voyage en ligne avant leur vol. Faites la demande quelques jours à l’avance et vérifiez votre nationalité sur le portail officiel, car la liste des pays exemptés et les règles changent.',
      },
      {
        question: 'Quel est le meilleur mois pour visiter Israël ?',
        answer:
