} satisfies Record<Exclude<Locale, 'en'>, HomeCopy>;
const copy: HomeCopy = COPY[locale];
/** The CTA arrow follows the reading direction: the layout sets dir="rtl" for Hebrew. */
const arrow = locale === 'he' ? '←' : '→';
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={`${prefix}/`}
  ogImage="/og-default.jpg"
  imageAlt={meta.title}
  alternates={homeAlternates()}
>
  <Hero
    image={HOME_HERO}
    credit={creditFor(HOME_HERO)}
    title={t('home.heroTitle')}
    subtitle={t('home.heroSubtitle')}
    alt={meta.alt}
    cta={{ href: `${prefix}/itineraries`, label: t('nav.itineraries') }}
  />

  <!-- Dense, data-rich intro (same content as the English home). -->
  <section class="mx-auto max-w-3xl px-4 pt-12">
    <p class="text-lg leading-relaxed text-ink" set:html={INTRO[locale]} />
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="regions">
    <h2 id="regions" class="mb-5 font-display text-3xl font-bold text-ink">{t('home.regionsHeading')}</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {REGIONS.map((r, i) => <DestinationCard region={r} eager={i < 4} href={`${prefix}/${r.slug}`} />)}
    </div>
  </section>

  <!-- The essentials: six short answers, each pointing to its full guide (same markup as the EN home). -->
  <section class="mx-auto max-w-6xl px-4 pt-16" aria-labelledby="essentials">
    <div class="mb-6" data-reveal>
      <p class="eyebrow">{copy.essentialsEyebrow}</p>
      <h2 id="essentials" class="font-display text-3xl font-bold text-ink">{copy.essentialsHeading}</h2>
      <p class="mt-3 max-w-3xl text-ink-muted">{copy.essentialsIntro}</p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        copy.essentials.map((e) => (
          <article class="flex flex-col rounded-card border border-border bg-card p-6 shadow-card">
            <h3 class="font-display text-xl font-bold text-ink">{e.heading}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-ink">{e.text}</p>
            <a href={e.href} class="mt-4 inline-block font-semibold text-primary">
              {e.cta} {arrow}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <FaqSection faqs={copy.faqs} />

  <section class="mx-auto max-w-6xl px-4 pt-4" aria-labelledby="plan">
    <h2 id="plan" class="mb-6 font-display text-3xl font-bold text-ink">{t('home.planHeading')}</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {
        groups.map((g) => (
          <div class="rounded-card border border-border bg-card p-5 shadow-card">
            <h3 class="font-display text-lg font-bold text-ink">{g.heading}</h3>
            <ul class="mt-3 space-y-1.5">
              {g.pages.map((p) => (
                <li>
                  <a href={`${prefix}/${p.slug}`} class="text-sm font-semibold text-primary no-underline hover:underline">
                    {t(p.key)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14 text-center">
    <a
      href={`${prefix}/itineraries`}
      class="me-2 inline-block rounded-full border border-primary px-6 py-3 text-sm font-semibold text-primary no-underline transition-colors hover:bg-primary-soft"
    >
      {t('nav.itineraries')}
    </a>
    <a
      href={`${prefix}/plan-your-trip`}
      class="inline-block rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
    >
      {t('nav.plan')}
    </a>
  </section>
</BaseLayout>
