---
/**
 * Locale-aware itineraries index, rendered by src/pages/itineraries/index.astro and
 * src/pages/{fr,de,es,he}/itineraries/index.astro. One template for the five
 * locales: hero, the itinerary cards from the collection, a "7 or 10 days" guide
 * (how to choose, rhythm, where to start, when to go) and three FAQs with FAQPage
 * schema via FaqSection. The copy below is editorial, written per locale; the facts
 * come from src/content/itineraries (no prices, no invented figures).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqSection from '@/components/FaqSection.astro';
import { useTranslations, pageAlternates, localeHome, localePrefix, splitEntryId, type Locale } from '@/i18n/ui';
import type { Faq } from '@/lib/schema';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = localePrefix(locale);
const path = `${prefix}/itineraries`;

const itineraries = (await getCollection('itineraries'))
  .filter((e) => splitEntryId(e.id).locale === locale)
  .sort((a, b) => (a.data.days ?? 0) - (b.data.days ?? 0));

const seven = `${prefix}/itineraries/7-days-in-israel`;
const ten = `${prefix}/itineraries/10-days-in-israel`;
const bestTime = `${prefix}/best-time-to-visit-israel`;
const firstTime = `${prefix}/first-time-in-israel`;
const a = (href: string, text: string) => `<a href="${href}">${text}</a>`;
/** Bold link, as the closing paragraph always had it. */
const b = (href: string, text: string) => `<a href="${href}" class="font-semibold text-primary">${text}</a>`;

interface Copy {
  title: string;
  description: string;
  heroTitle: string;
  heroSubtitle: string;
  heroAlt: string;
  crumb: string;
  intro: string;
  daysLabel: string;
  chooseHeading: string;
  /** Paragraphs may carry <a> tags built with a(); rendered with set:html. */
  chooseIntro: string;
  blocks: { heading: string; text: string }[];
  faqs: Faq[];
  outro: string;
}

