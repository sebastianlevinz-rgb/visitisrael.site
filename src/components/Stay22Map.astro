---
/**
 * Stay22 hotel map. The embed only works with a real Stay22 AID, so without one
 * nothing renders — no broken iframe and no placeholder ID in the HTML.
 */
import { AFFILIATE_IDS } from '@/config/affiliates';
export interface Props {
  lat: number;
  lng: number;
  label: string;
}
const { lat, lng, label } = Astro.props;
const aid = AFFILIATE_IDS.STAY22_AID;
const src = aid
  ? `https://www.stay22.com/embed/gm?${new URLSearchParams({ aid, lat: String(lat), lng: String(lng), maincolor: '1a6985' })}`
  : '';
---

{
  src && (
    <>
      <div class="overflow-hidden rounded-card border border-border shadow-card">
        <iframe
          src={src}
          title={`Hotel map for ${label}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-[360px] w-full border-0"
        />
      </div>
      <p class="mt-1 text-center text-[11px] text-ink-muted">Interactive hotel map · powered by Stay22</p>
    </>
  )
}
