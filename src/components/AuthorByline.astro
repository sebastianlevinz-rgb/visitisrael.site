---
import { defaultAuthor, type Author } from '@/data/authors';
import { getLocaleFromPath, intlLocale, useTranslations } from '@/i18n/ui';
export interface Props {
  author?: Author;
  updated?: Date;
}
const { author = defaultAuthor, updated } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const updatedDate = updated ?? new Date();
const updatedLabel = updatedDate.toLocaleDateString(intlLocale[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const updatedIso = updatedDate.toISOString().slice(0, 10);
---

<div
  class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-4 text-sm text-ink-muted"
>
  <span
    class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-soft font-display font-bold text-primary"
    aria-hidden="true">VI</span
  >
  <p>
    {t('byline.by')} <a href={author.url} class="font-semibold text-ink no-underline hover:text-primary">{author.name}</a>
    · {t('byline.updated')} <time datetime={updatedIso}>{updatedLabel}</time>
  </p>
</div>
