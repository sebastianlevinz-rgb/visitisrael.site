---
import { affiliateUrl, PARTNERS, type Partner } from '@/config/affiliates';
import { fill, getLocaleFromPath, useTranslations } from '@/i18n/ui';
import Pic from '@/components/Pic.astro';

export interface Props {
  partner: Partner;
  title: string;
  description: string;
  image: string;
  destination?: string;
  query?: string;
  productId?: string;
  cta?: string;
  /** Stable format label ("Walking tour", "Full day"). Never a price or rating. */
  type?: string;
  /** Approximate duration ("~3–4 h"). */
  duration?: string;
}
const t = useTranslations(getLocaleFromPath(Astro.url.pathname));
const {
  partner,
  title,
  description,
  image,
  destination,
  query,
  productId,
  cta = t('card.bookNow'),
  type,
  duration,
} = Astro.props;

const meta = PARTNERS[partner];
const href = affiliateUrl(partner, { destination, query, productId });
const badge =
  meta.category === 'tours' ? t('card.badge.tour') : meta.category === 'hotels' ? t('card.badge.stay') : meta.label;
const facts = [type, duration].filter(Boolean).join(' · ');
const [livePre, livePost] = t('card.livePrices').split('{partner}');
---

<article
  class="group flex flex-col overflow-hidden rounded-card border border-border bg-card shadow-card transition-shadow hover:shadow-card-hover"
  data-affiliate-card
  data-partner={partner}
>
  <div class="img-zoom relative aspect-[16/10]">
    <Pic
      src={image}
      alt={title}
      width="800"
      height="500"
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
      class="h-full w-full object-cover"
    />
    <span
      class="absolute start-3 top-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-sm"
    >
      {badge}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    {/* Card copy may be English data on a Hebrew page: dir="auto" follows the text. */}
    <h3 class="font-display text-lg font-bold leading-snug text-ink" dir="auto">{title}</h3>
    {facts && <p class="-mt-1 text-xs text-ink-muted" dir="auto">{facts}</p>}
    <p class="line-clamp-2 text-sm text-ink-muted" dir="auto">{description}</p>

    <div class="mt-auto pt-2">
      {/* Live, real price & reviews live on the partner site — we don't show
          unverified figures here. */}
      <p class="mb-2 text-sm text-ink-muted">
        {livePre}<span class="font-semibold text-ink">{meta.label}</span>{livePost}
      </p>
      {/* The affiliate disclosure is rendered once per section by the page, before the grid. */}
      <a
        href={href}
        target="_blank"
        rel="sponsored nofollow noopener"
        class="mt-2 flex w-full items-center justify-center rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover"
      >
        {cta}
      </a>
      <p class="mt-1.5 text-center text-[11px] text-ink-muted">{fill(t('card.via'), { partner: meta.label })}</p>
    </div>
  </div>
</article>
