---
/**
 * Locale-aware "Plan your trip" hub, rendered by src/pages/plan-your-trip.astro and
 * src/pages/{fr,de,es}/plan-your-trip.astro. Lists the site's page groups (the v3
 * taxonomy), the itineraries and the regions — every link exists in the locale.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import DestinationCard from '@/components/DestinationCard.astro';
import { REGIONS } from '@/data/regions';
import { useTranslations, pageAlternates, localeHome, localePrefix, PAGE_GROUPS, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = localePrefix(locale);
const path = `${prefix}/plan-your-trip`;
const crumbs = [
  { name: t('nav.home'), path: localeHome(locale) },
  { name: t('nav.plan'), path },
];

const guides = await getCollection('guides');
const guideTitle = (slug: string) => {
  const entry = guides.find((g) => g.id === (locale === 'en' ? slug : `${locale}/${slug}`));
  return entry?.data.title.split(':')[0] ?? slug;
};
const groups = [
  { id: 'practical', heading: t('plan.practicalHeading'), pages: PAGE_GROUPS.practical },
  { id: 'stay', heading: t('plan.stayHeading'), pages: PAGE_GROUPS.stay },
  { id: 'tours', heading: t('plan.toursHeading'), pages: PAGE_GROUPS.tours },
];

const itineraries = (await getCollection('itineraries'))
  .filter((e) => (locale === 'en' ? !e.id.includes('/') : e.id.startsWith(`${locale}/`)))
  .sort((a, b) => (a.data.days ?? 0) - (b.data.days ?? 0));
const itineraryId = (id: string) => (locale === 'en' ? id : id.slice(locale.length + 1));
---

<BaseLayout
  title={t('plan.title')}
  description={t('plan.description')}
  path={path}
  ogImage="/og-default.jpg"
  imageAlt={t('plan.heroTitle')}
  alternates={pageAlternates('plan-your-trip')}
>
  <Hero
    image="/images/regions/tel-aviv/hero.jpg"
    title={t('plan.heroTitle')}
    subtitle={t('plan.heroSubtitle')}
    alt={t('plan.heroTitle')}
  />
  <Breadcrumbs items={crumbs} />

  {
    groups.map((g) => (
      <section class="mx-auto max-w-6xl px-4 pt-10" aria-labelledby={`plan-${g.id}`}>
        <h2 id={`plan-${g.id}`} class="mb-5 font-display text-3xl font-bold text-ink">
          {g.heading}
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.pages.map((p) => (
            <a
              href={`${prefix}/${p.slug}`}
              class="rounded-card border border-border bg-card p-5 no-underline shadow-card transition-shadow hover:shadow-card-hover"
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-primary">{t(p.key)}</span>
              <h3 class="mt-1 font-display text-base font-bold leading-snug text-ink">{guideTitle(p.slug)}</h3>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="plan-itineraries">
    <h2 id="plan-itineraries" class="mb-5 font-display text-3xl font-bold text-ink">
      {t('plan.itinerariesHeading')}
    </h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        itineraries.map((it) => (
          <a
            href={`${prefix}/itineraries/${itineraryId(it.id)}`}
            class="rounded-card border border-border bg-card p-5 no-underline shadow-card transition-shadow hover:shadow-card-hover"
          >
            <h3 class="font-display text-base font-bold leading-snug text-ink">{it.data.title.split(':')[0]}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-ink-muted">{it.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-12" aria-labelledby="plan-regions">
    <h2 id="plan-regions" class="mb-5 font-display text-3xl font-bold text-ink">{t('plan.regionsHeading')}</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {REGIONS.map((r) => <DestinationCard region={r} href={`${prefix}/${r.slug}`} />)}
    </div>
  </section>
</BaseLayout>
