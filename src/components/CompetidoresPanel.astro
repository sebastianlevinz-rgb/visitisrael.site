/**
 * /gestion/competidores — el estudio de mercado de gestion/auditoria/competidores.md
 * contado en tarjetas, con el mismo lenguaje visual que /mariluz#numeros: un dato
 * grande por tarjeta, chips, grillas que apilan en móvil y nada de tablas anchas.
 *
 * Los datos de abajo salen del markdown (fecha 2026-09-17; Israel Together agregado el
 * 2026-09-22). Si un dato no está en el informe, no está acá. El informe completo se
 * muestra entero al final, dentro de un <details>, para no perder nada.
 *
 * Colores: azul = nosotros / primary; dorado = destacado; gris = neutro.
 */

type Kind = 'oficial' | 'operador' | 'medio' | 'blog' | 'marketplace' | 'agencia';

type Site = {
  name: string;
  domain: string; // lo que se ve
  url: string; // siempre https://
  langs: string;
  kind: Kind;
  traffic: string; // dato grande
  trafficNote?: string;
  model: string; // modelo de ingresos, una línea
  good: string; // qué hacen bien, 1–2 líneas
  lesson: string; // qué nos enseña, 1 línea
  highlight?: boolean; // dorado
};

type SmallSite = { name: string; domain: string; url: string; kind: Kind; line: string };

type Starter = {
  name: string;
  domain: string;
  url: string;
  who: string;
  traffic: string;
  model: string;
  good: string;
};

type Light = 'green' | 'amber' | 'red';
type Criterion = { name: string; them: string; us: string; light: Light; word: string };

const kindLabel: Record<Kind, string> = {
  oficial: 'oficial',
  operador: 'operador',
  medio: 'medio',
  blog: 'blog',
  marketplace: 'marketplace',
  agencia: 'agencia',
};

