    name: 'We Travel Portugal',
    domain: 'wetravelportugal.com',
    url: 'https://www.wetravelportugal.com/',
    who: 'Ana Veiga + Ollie Richards, Lisboa, desde 2018',
    traffic: '~43,1K',
    model: 'GYG, Booking/Stay22, Viator + itinerarios personalizados + newsletter.',
    good: 'Fotografía propia como diferencial en el H1; guías por pueblo con "[2026]" en el título, TOC y precios "desde" en texto; Stay22 para hoteles sin armar widgets.',
  },
];

/* 4. Nosotros contra ellos (§4.1 en filas) */
const criteria: Criterion[] = [
  { name: 'Idiomas', them: '1; Sommertage 2; Petra On The Way 3.', us: '5 (EN, FR, DE, ES, HE).', light: 'green', word: 'Ventaja' },
  { name: 'Profundidad por destino', them: '2.000–4.000 palabras "updated 2026" en los blogs chicos que rinden; ~540 en Tourist Israel.', us: '~2.600 en EN; 600–800 en FR, DE y ES.', light: 'amber', word: 'A medias' },
  { name: 'Autor con nombre y cara', them: 'Sí, con credencial (guía certificado, "nacida en Atenas").', us: 'No: "The Visit Israel Editorial Team", avatar "VI".', light: 'red', word: 'Falta' },
  { name: 'Reseñas y prueba social', them: 'Google Reviews (Portugalist 152), TripAdvisor, "300 consultas", comentarios abiertos.', us: 'Nada.', light: 'red', word: 'Falta' },
  { name: 'Precio y rating en la tarjeta de tour', them: 'Sí: propio en operadores; widget de GetYourGuide en LP, Atlas y Sommertage.', us: 'No: "Live prices on GetYourGuide".', light: 'red', word: 'Falta' },
  { name: 'Partners activos', them: '3–5 con ID: GYG, Booking, Civitatis, Viator, operadores con código.', us: '11 definidos en affiliates.ts, 0 con ID.', light: 'red', word: 'Falta' },
  { name: 'Medición de clics por caja', them: 'Chavetas: 14 eventos por ubicación. Petra: tagging de campañas GYG.', us: 'No: Vercel Analytics sin eventos.', light: 'red', word: 'Falta' },
  { name: 'Fotos', them: 'Propias; We Travel Portugal las usa como diferencial.', us: 'Stock con crédito (Pexels, Wikimedia, Unsplash).', light: 'amber', word: 'A medias' },
  { name: 'Servicio propio', them: 'Planificación, tours, códigos negociados con operadores locales.', us: 'No; es la propuesta con Mariluz en gestion/negocio.', light: 'red', word: 'Falta' },
  { name: 'Tráfico (agosto 2026)', them: '8–86K los sitios chicos; ~105K Tourist Israel.', us: 'Sin medición.', light: 'red', word: 'Sin dato' },
];

const verdict =
  'Tenemos la estructura de un sitio que factura y ninguna de las tres cosas que hacen facturar. La estructura (KeyFacts, TourVerdict, Toc, BookYourTrip, FAQ con schema, HTML liviano, 5 idiomas) está por encima de todos los blogs de nicho de Israel y a la par de los sitios chicos que funcionan en Grecia y Portugal. Pero esos sitios cobran porque tienen IDs cargados, una persona con nombre que responde comentarios y vende un servicio propio, y miden qué caja convierte. Nosotros tenemos cero de las tres. El mercado en inglés no tiene ningún afiliado fuerte vivo, así que el hueco existe. En español el hueco es de calidad (contenido de 2012 con cajas de afiliado) y en francés de fecha (guías 2019–2023). El punto de partida realista es el de Bachelor of Travel (US$38/mes con 4.000 sesiones), no el de Nomadic Matt, y el tráfico de Israel cayó 10–29 % en agosto por la guerra: la recuperación real la ponen en Pésaj 2027. Esto se gana en 2027, con una cara y con datos, no con más páginas.';

const actions: [string, string][] = [
  [
    'Cargar los IDs de GetYourGuide, Civitatis y Viator, sumar Bein Harim (15 %, 90 días, ShareASale 48735) a affiliates.ts y entrar a Booking por CJ o Awin.',
    'Es la fase 3 del ROADMAP y depende solo de Sebastian. Hasta que un clic registre, nada de lo demás se puede evaluar. Bajar los partners activos a 5: GYG, Civitatis (ES), Viator, Bein Harim, Booking.',
  ],
  [
    'Poner una persona con nombre, foto y credencial en authors.ts y en /about,',
    'y que el byline diga "Israel travel writer since…" o "guía licenciada" (si la propuesta con Mariluz avanza, es ella; si no, Sebastian con su rol real). Es la única mejora que todos los sitios chicos que rinden comparten.',
  ],
  [
    'Reemplazar la grilla de tours de región por el widget nativo de GetYourGuide (3–4 ítems por destino) con el kicker "In partnership with GetYourGuide" y un solo disclosure,',
    'como LP, Atlas y Sommertage. Muestra precio y rating reales sin inventarlos. En ES, el mismo bloque con el widget de Civitatis. Necesita aprobación (cambia el look) y el ID del paso 1.',
  ],
  [
    'Medir clics por caja y por página con eventos de Vercel Analytics',
    '(StickyCTA, BookYourTrip, AffiliateCard, InlineTourCTA, widget), con un nombre de ubicación por evento como hace Chavetas. Sin esto, en la fase 4 ("esperar datos") no va a haber datos. Costo: dos tardes.',
  ],
  [
    'Completar la batería de partners por idioma en las páginas que ya existen, sin crear páginas nuevas:',
    'en ES, caja de seguro con código (IATI o Heymondo, 5 %) y Holafly en plan-your-trip y en las guías prácticas; en DE, la marca "enthält Werbung" y links con asterisco (obligación legal); en FR, fecha "mis à jour 2026" visible arriba. Y completar las traducciones de región a por lo menos 1.500 palabras antes de traducir nada nuevo.',
  ],
];

const lightTone: Record<Light, { badge: string; dot: string }> = {
  green: { badge: 'bg-green-100 text-green-800', dot: 'bg-green-600' },
  amber: { badge: 'bg-amber-100 text-amber-800', dot: 'bg-amber-500' },
  red: { badge: 'bg-red-100 text-red-800', dot: 'bg-red-600' },
};

const chip = 'inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold';
---

<section class="mx-auto max-w-5xl">
  <p class="eyebrow">Estudio de mercado · 17-09-2026, Israel Together agregado el 22-09-2026</p>
  <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">Competidores</h1>
  <p class="mt-3 max-w-3xl text-lg text-ink-muted">
    Quién más habla de viajar a Israel, cómo gana plata y qué nos enseña. Una idea por tarjeta. Las cifras de
    tráfico son de SimilarWeb gratuito (agosto 2026): <strong class="text-ink">orden de magnitud, con un margen de
    ×3 hacia abajo</strong>, no dato exacto. Cada sitio tiene su link.
  </p>

  <!-- 0. En diez líneas -->
  <div class="mt-12">
    <h2 class="font-display text-2xl font-bold text-ink">En diez líneas</h2>
    <ol class="mt-6 space-y-3">
      {
        tenLines.map(([h, t], i) => (
          <li class="flex gap-4 rounded-card border border-border bg-card p-4 shadow-card">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-display text-sm font-bold text-white">{i + 1}</span>
            <p class="text-ink"><strong>{h}</strong> {t}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- 1. Los que más importan -->
  <div class="mt-16">
    <h2 class="font-display text-2xl font-bold text-ink">1. Los que más importan</h2>
    <p class="mt-2 max-w-3xl text-ink-muted">
      Diez sitios. El número grande es visitas por mes según SimilarWeb, orden de magnitud. Borde dorado: los que
      más nos enseñan.
    </p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        top.map((s) => (
          <article class={`flex flex-col rounded-card border-2 bg-card p-5 shadow-card ${s.highlight ? 'border-gold' : 'border-border'}`}>
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-display text-xl font-bold text-ink">{s.name}</h3>
                <a href={s.url} target="_blank" rel="noopener" class="break-all text-sm text-primary underline">{s.domain} ↗</a>
              </div>
              <div class="shrink-0 text-end">
                <p class="font-display text-2xl font-bold text-primary">{s.traffic}</p>
                <p class="text-xs text-ink-muted">visitas/mes</p>
              </div>
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              <span class={`${chip} bg-sand-deep text-ink`}>{s.langs}</span>
              <span class={`${chip} ${s.kind === 'operador' || s.kind === 'agencia' ? 'bg-gold/15 text-gold-deep' : 'bg-primary-soft text-primary'}`}>{kindLabel[s.kind]}</span>
            </div>
            <p class="mt-2 text-xs text-ink-muted">
              SimilarWeb, orden de magnitud{s.trafficNote ? ` · ${s.trafficNote}` : ''}.
            </p>
            <dl class="mt-4 flex-1 space-y-3">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Cómo gana plata</dt>
                <dd class="mt-0.5 text-sm text-ink">{s.model}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Qué hacen bien</dt>
                <dd class="mt-0.5 text-sm text-ink">{s.good}</dd>
              </div>
            </dl>
            <div class="mt-4 rounded-btn bg-sand-deep p-3 text-sm">
              <p class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Qué nos enseña</p>
              <p class="mt-1 font-semibold text-ink">{s.lesson}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- 2. Por idioma -->
  <div class="mt-16">
    <h2 class="font-display text-2xl font-bold text-ink">2. Los demás, por idioma</h2>
    <p class="mt-2 max-w-3xl text-ink-muted">Una línea por sitio. Cifras: visitas por mes, SimilarWeb, orden de magnitud.</p>
    <div class="mt-6 space-y-8">
      {
        byLang.map((b) => (
          <div>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="rounded-full bg-primary px-3 py-1 font-display text-sm font-bold text-white">{b.code}</span>
              <h3 class="font-display text-xl font-bold text-ink">{b.title}</h3>
            </div>
            {b.note && <p class="mt-2 max-w-3xl text-sm text-ink-muted">{b.note}</p>}
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {b.sites.map((s) => (
                <div class="rounded-card border border-border bg-card p-4 shadow-card">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
                    <p class="font-display font-bold text-ink">{s.name}</p>
                    <span class={`${chip} bg-sand-deep text-ink-muted`}>{kindLabel[s.kind]}</span>
                  </div>
                  <a href={s.url} target="_blank" rel="noopener" class="break-all text-xs text-primary underline">{s.domain} ↗</a>
                  <p class="mt-2 text-sm text-ink">{s.line}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 3. Los que están empezando -->
  <div class="mt-16">
    <h2 class="font-display text-2xl font-bold text-ink">3. Los que están empezando o están a nuestro nivel</h2>
    <p class="mt-2 max-w-3xl text-ink-muted">
      Ocho sitios de una o dos personas, de un solo país (Jordania, Grecia, Portugal) o de nicho, y qué hacen bien
      con pocos recursos.
    </p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        starters.map((s) => (
          <article class="flex flex-col rounded-card border border-border bg-card p-5 shadow-card">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h3 class="font-display text-lg font-bold text-ink">{s.name}</h3>
                <a href={s.url} target="_blank" rel="noopener" class="break-all text-sm text-primary underline">{s.domain} ↗</a>
                <p class="mt-1 text-xs text-ink-muted">{s.who}</p>
              </div>
              <div class="shrink-0 text-end">
                <p class={`font-display font-bold text-primary ${s.traffic.length > 7 ? 'text-lg' : 'text-2xl'}`}>{s.traffic}</p>
                <p class="text-xs text-ink-muted">visitas/mes</p>
              </div>
            </div>
            <dl class="mt-4 flex-1 space-y-3">
              <div>
                <dt class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Cómo gana plata</dt>
                <dd class="mt-0.5 text-sm text-ink">{s.model}</dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-widest text-ink-muted">Qué hace bien con poco</dt>
                <dd class="mt-0.5 text-sm text-ink">{s.good}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
    <div class="mt-6 rounded-card border-2 border-gold bg-gold/10 p-5">
      <p class="text-xs font-semibold uppercase tracking-widest text-gold-deep">El punto de partida realista</p>
      <p class="mt-2 font-display text-4xl font-bold text-ink">US$38,56</p>
      <p class="mt-1 text-ink">
        <strong>Bachelor of Travel, agosto 2025</strong>: una persona, 120 posts, ~4.000 sesiones. GetYourGuide 20,50;
        DiscoverCars 9,84; Stay22 7,61; Amazon 0,61. Es el sitio más parecido al nuestro que publica números.
      </p>
      <p class="mt-2 text-sm text-ink-muted">
        Regla práctica de Top Travel Sights: ~€100 por trimestre de GetYourGuide con 25K usuarios/mes. Y Living the
        Dream: el 90 % de sus US$10.800 viene del blog hiperlocal, no del global. Lo hiperlocal monetiza mejor.
      </p>
    </div>
  </div>

  <!-- 4. Nosotros contra ellos -->
  <div class="mt-16">
    <h2 class="font-display text-2xl font-bold text-ink">4. Nosotros contra ellos</h2>
    <p class="mt-2 max-w-3xl text-ink-muted">
      Datos nuestros al 17-09-2026: 163 páginas en 5 idiomas, 7 regiones, 19 guías, 2 itinerarios, 32 fotos con
      crédito, un autor genérico, 11 partners definidos y 0 IDs cargados. Por cada criterio: qué hacen los sitios
      que rinden, qué tenemos nosotros y un semáforo.
    </p>
    <ul class="mt-6 space-y-3">
      {
        criteria.map((c) => (
          <li class="grid gap-3 rounded-card border border-border bg-card p-4 shadow-card md:grid-cols-[1fr_1fr_8rem] md:items-start">
            <div>
              <p class="font-display font-bold text-ink">{c.name}</p>
              <p class="mt-0.5 text-xs font-semibold uppercase tracking-widest text-ink-muted">Los que rinden</p>
              <p class="mt-0.5 text-sm text-ink">{c.them}</p>
            </div>
            <div class="rounded-btn bg-primary-soft p-3">
              <p class="text-xs font-semibold uppercase tracking-widest text-primary">Nosotros</p>
              <p class="mt-0.5 text-sm text-ink">{c.us}</p>
            </div>
            <div class="flex items-center gap-2 md:justify-end">
              <span class={`inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm font-bold ${lightTone[c.light].badge}`}>
                <span class={`h-2.5 w-2.5 rounded-full ${lightTone[c.light].dot}`} aria-hidden="true" />
                {c.word}
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 rounded-card border-2 border-primary bg-primary-soft p-6">
      <p class="eyebrow">Veredicto</p>
      <p class="text-ink">{verdict}</p>
    </div>

    <h3 class="mt-10 font-display text-xl font-bold text-ink">Cinco acciones, en orden</h3>
    <ol class="mt-4 space-y-3">
      {
        actions.map(([h, t], i) => (
          <li class="flex gap-4 rounded-card border border-border bg-card p-4 shadow-card">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-display text-sm font-bold text-white">{i + 1}</span>
            <p class="text-ink"><strong>{h}</strong> {t}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-4 max-w-3xl text-sm text-ink-muted">
      Lo que no vale la pena ahora: fotos propias (ayuda, pero no antes de los IDs), newsletter sin lead magnet,
      mapa interactivo, más páginas, más idiomas.
    </p>
  </div>

  <!-- 5. Informe completo -->
  <details class="mt-16 rounded-card border border-border bg-card shadow-card">
    <summary class="cursor-pointer px-5 py-4 font-display text-lg font-bold text-ink">
      Informe completo (el markdown entero, con todas las tablas)
    </summary>
    <div class="prose-content report border-t border-border px-5 py-6">
      <slot />
    </div>
  </details>

  <p class="mt-8 text-xs text-ink-muted">
    Fuentes: SimilarWeb gratuito (agosto 2026), HypeStat, Semrush donde respondió, y el HTML de cada sitio,
    consultados el 17-09-2026. Israel Together: copia de Wayback del 07-09-2025, Facebook y prensa, consultados el
    22-09-2026. Semrush devolvió 404 en casi todos los dominios; ninguna cifra de facturación es real, son
    estimaciones tráfico × RPM que sirven para comparar, no para planificar.
  </p>
</section>

<style>
  /* El informe completo dentro de <details>: tablas anchas con scroll, sin romper el ancho de la página. */
  .report :global(h2),
  .report :global(h3),
  .report :global(h4) {
    font-family: var(--font-display);
    font-weight: 700;
  }
  .report :global(h4) {
    font-size: var(--text-lg);
    margin-top: 1.4rem;
  }
  .report :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: 2rem;
  }
  .report :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    font-size: 0.875rem;
  }
  .report :global(td),
  .report :global(th) {
    min-width: 8rem;
    vertical-align: top;
  }
  .report :global(code) {
    font-size: 0.85em;
    background: var(--color-sand-deep);
    padding: 0.1em 0.3em;
    border-radius: 4px;
  }
  /* Dominios con ruta y URLs largas (títulos 2.x, fuentes): que corten en vez de ensanchar la página. */
  .report {
    overflow-wrap: anywhere;
  }
</style>
