---
/**
 * "Plan your trip to X" closing box — the commercial close that the best affiliate
 * guides (Nomadic Matt, Earth Trekkers) put at the end of every article. One row per
 * booking need, every link through the central affiliate helper; one disclosure.
 */
import { affiliateUrl } from '@/config/affiliates';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import type { Locale } from '@/i18n/ui';

export interface Props {
  locale: Locale;
  /** Destination name in the page's language, used in headings. */
  place: string;
  /** Destination in English, used for partner search queries. */
  query: string;
}
const { locale, place, query } = Astro.props;

const STRINGS = {
  en: {
    title: (p: string) => `Plan your trip to ${p}`,
    intro: 'The bookings most travellers make for this trip, on the sites we use ourselves.',
    flights: 'Flights to Israel',
    hotels: (p: string) => `Hotels in ${p}`,
    tours: (p: string) => `Tours & day trips in ${p}`,
    car: 'Car rental in Israel',
    insurance: 'Travel insurance',
    go: 'Search',
  },
  fr: {
    title: (p: string) => `Préparez votre voyage à ${p}`,
    intro: 'Les réservations que font la plupart des voyageurs, sur les sites que nous utilisons nous-mêmes.',
    flights: 'Vols vers Israël',
    hotels: (p: string) => `Hôtels à ${p}`,
    tours: (p: string) => `Circuits et excursions à ${p}`,
    car: 'Location de voiture en Israël',
    insurance: 'Assurance voyage',
    go: 'Rechercher',
  },
  de: {
    title: (p: string) => `Planen Sie Ihre Reise nach ${p}`,
    intro: 'Die Buchungen, die die meisten Reisenden für diese Reise machen – auf den Seiten, die wir selbst nutzen.',
    flights: 'Flüge nach Israel',
    hotels: (p: string) => `Hotels in ${p}`,
    tours: (p: string) => `Touren & Ausflüge in ${p}`,
    car: 'Mietwagen in Israel',
    insurance: 'Reiseversicherung',
    go: 'Suchen',
  },
  es: {
    title: (p: string) => `Planifica tu viaje a ${p}`,
    intro: 'Las reservas que hace la mayoría de los viajeros para este viaje, en los sitios que usamos nosotros.',
    flights: 'Vuelos a Israel',
    hotels: (p: string) => `Hoteles en ${p}`,
    tours: (p: string) => `Tours y excursiones en ${p}`,
    car: 'Alquiler de coche en Israel',
    insurance: 'Seguro de viaje',
    go: 'Buscar',
  },
  he: {
    title: (p: string) => `תכננו את הטיול ל${p}`,
    intro: 'ההזמנות שרוב המטיילים עושים לטיול הזה, באתרים שאנחנו משתמשים בהם בעצמנו.',
    flights: 'טיסות לישראל',
    hotels: (p: string) => `מלונות ב${p}`,
    tours: (p: string) => `סיורים וטיולי יום ב${p}`,
    car: 'השכרת רכב בישראל',
    insurance: 'ביטוח נסיעות',
    go: 'חיפוש',
  },
} as const satisfies Record<Locale, unknown>;
const s = STRINGS[locale];

const rows = [
  { label: s.flights, href: affiliateUrl('skyscanner'), partner: 'Skyscanner', icon: 'M2 16l20-8-8 20-2-9z' },
  { label: s.hotels(place), href: affiliateUrl('booking', { destination: query }), partner: 'Booking.com', icon: 'M3 21V8l9-5 9 5v13M9 21v-6h6v6' },
  { label: s.tours(place), href: affiliateUrl('getyourguide', { query: `${query} tour` }), partner: 'GetYourGuide', icon: 'M12 2l3 7h7l-5.5 4.5 2 7.5-6.5-4.5L5.5 21l2-7.5L2 9h7z' },
  { label: s.car, href: affiliateUrl('discovercars', { destination: query }), partner: 'DiscoverCars', icon: 'M5 17h14M5 17l1-5h12l1 5M7 12l2-5h6l2 5M7 17v2M17 17v2' },
  { label: s.insurance, href: affiliateUrl('safetywing'), partner: 'SafetyWing', icon: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z' },
];
---

<aside class="mx-auto my-12 max-w-3xl px-4" aria-labelledby="book-your-trip">
  <div class="rounded-card border border-border bg-sand-deep p-6">
    <h2 id="book-your-trip" class="font-display text-2xl font-bold text-ink">{s.title(place)}</h2>
    <p class="mt-1 text-sm text-ink-muted">{s.intro}</p>
    <ul class="mt-4 divide-y divide-border">
      {
        rows.map((r) => (
          <li>
            <a
              href={r.href}
              target="_blank"
              rel="sponsored nofollow noopener"
              class="flex items-center justify-between gap-4 py-3 no-underline"
            >
              <span class="flex items-center gap-3">
                <svg class="h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={r.icon} />
                </svg>
                <span class="font-semibold text-ink">{r.label}</span>
                <span class="text-xs text-ink-muted" dir="auto">· {r.partner}</span>
              </span>
              <span class="shrink-0 rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-white">{s.go}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-3">
      <AffiliateDisclosure compact />
    </div>
  </div>
</aside>
