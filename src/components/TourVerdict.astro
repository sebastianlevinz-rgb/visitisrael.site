---
import { affiliateUrl, PARTNERS, type Partner } from '@/config/affiliates';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import { fill, getLocaleFromPath, useTranslations } from '@/i18n/ui';

export interface Props {
  name: string;
  partner?: Partner;
  query: string;
  reasons?: string[];
  caveat?: string;
}

const t = useTranslations(getLocaleFromPath(Astro.url.pathname));
const {
  name,
  partner = 'getyourguide',
  query,
  reasons = [t('verdict.reason1'), t('verdict.reason2'), t('verdict.reason3')],
  caveat,
} = Astro.props;

const href = affiliateUrl(partner, { query });
const meta = PARTNERS[partner];
---

<aside
  class="my-8 overflow-hidden rounded-card border-2 border-primary bg-card shadow-card"
  data-tour-verdict
  aria-labelledby="verdict-heading"
>
  <div class="flex flex-wrap items-center gap-3 border-b border-border bg-sand-deep px-5 py-3">
    <span class="text-xs font-semibold uppercase tracking-wide text-ink-muted">{t('verdict.kicker')}</span>
    <h2 id="verdict-heading" class="font-display text-lg font-bold text-ink">
      {fill(t('verdict.question'), { name })}
    </h2>
    <span
      class="ms-auto shrink-0 rounded-full bg-primary px-3 py-0.5 text-sm font-semibold text-white"
      aria-label={t('verdict.badgeLabel')}
    >
      {t('verdict.badge')}
    </span>
  </div>

  <div class="p-5">
    <ul class="mb-5 space-y-2" aria-label={t('verdict.reasonsLabel')}>
      {
        reasons.map((r) => (
          <li class="flex gap-2.5 text-sm text-ink">
            <span class="mt-0.5 shrink-0 font-bold text-primary" aria-hidden="true">✓</span>
            {r}
          </li>
        ))
      }
    </ul>

    {caveat && <p class="mb-4 text-sm italic text-ink-muted">{caveat}</p>}

    {/* Standalone aside inside an article: keeps its own compact disclosure, DOM-preceding the link. */}
    <AffiliateDisclosure compact />
    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="mt-3 inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      {fill(t('verdict.cta'), { name })} · {meta.label}
    </a>
  </div>
</aside>
