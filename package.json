{
  "name": "visitisrael.site",
  "version": "0.2.0",
  "private": true,
  "description": "Visit Israel — English travel guide (Astro SSG)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/photos/gen-avif-webp.mjs && astro build",
    "preview": "astro preview",
    "check": "node scripts/lint-meta-length.mjs && node scripts/qa/photo-guard.mjs --src && astro check",
    "photos": "node scripts/photos/fetch.mjs",
    "photos:search": "node scripts/photos/search.mjs",
    "photos:formats": "node scripts/photos/gen-avif-webp.mjs",
    "photos:og": "node scripts/photos/gen-og.mjs",
    "qa:shots": "node scripts/qa/screenshots.mjs",
    "check:links": "node scripts/qa/check-links.mjs",
    "seo:onpage": "node scripts/seo/onpage.mjs",
    "seo:psi": "node scripts/seo/psi.mjs",
    "seo:refresh": "node scripts/seo/refresh.mjs",
    "test:e2e": "playwright test",
    "check:affiliates": "node scripts/qa/affiliate-guard.mjs",
    "check:photos": "node scripts/qa/photo-guard.mjs",
    "test:qa": "node --test \"scripts/qa/__tests__/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource/playfair-display": "^5.2.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.4.8",
    "astro-pagefind": "^2.0.0",
    "leaflet": "^1.9.4",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^1.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
